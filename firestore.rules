rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function owner() {
      return signedIn()
        && request.auth.token.email_verified == true
        && request.auth.token.email in [
          'nakamurakouta512@gmail.com',
          'mono.create.group@gmail.com'
        ];
    }

    function accessPath(uid) {
      return /databases/$(database)/documents/access/$(uid);
    }

    function accessControlPath() {
      return /databases/$(database)/documents/system/access_control;
    }

    function invoiceAuthorizationPath(uid, authorizationId) {
      return /databases/$(database)/documents/editor_portals/$(uid)/invoice_authorizations/$(authorizationId);
    }

    function invoicePath(uid, invoiceId) {
      return /databases/$(database)/documents/editor_portals/$(uid)/editor_invoices/$(invoiceId);
    }

    function validInvoiceAuthorization(uid, invoiceId) {
      let path = invoiceAuthorizationPath(uid, request.resource.data.authorizationId);
      return exists(path)
        && get(path).data.active == true
        && get(path).data.taxInclusive == true
        && request.resource.data.taxInclusive == true
        && get(path).data.editorUid == uid
        && get(path).data.revision == request.resource.data.authorizationRevision
        && get(path).data.invoiceVersion == request.resource.data.version
        && get(path).data.invoiceDocumentId == invoiceId
        && get(path).data.month == request.resource.data.month
        && get(path).data.jobIds == request.resource.data.jobIds
        && get(path).data.lines == request.resource.data.lines
        && get(path).data.subtotal == request.resource.data.subtotal
        && get(path).data.taxByRate == request.resource.data.taxByRate
        && get(path).data.tax == request.resource.data.tax
        && get(path).data.total == request.resource.data.total
        && get(path).data.invoiceAvailableOn == request.resource.data.invoiceAvailableOn
        && get(path).data.paymentDueDate == request.resource.data.paymentDueDate
        && request.resource.data.issueDate == request.resource.data.invoiceAvailableOn
        && request.resource.data.dueDate == request.resource.data.paymentDueDate;
    }

    // 請求書の発行者欄に印字する任意の住所。必須にはしない。
    function validIssuerAddress() {
      return request.resource.data.get('address', '') is string
        && request.resource.data.get('address', '').size() <= 120;
    }

    function validManualInvoice(uid) {
      return request.resource.data.authorizationId == 'manual'
        && request.resource.data.taxInclusive == true
        && request.resource.data.authorizationRevision == 0
        && request.resource.data.version is int
        && request.resource.data.version >= 1
        && request.resource.data.editorUid == uid
        && request.resource.data.jobIds is list
        && request.resource.data.jobIds.size() >= 1
        && request.resource.data.jobIds.size() <= 50
        && request.resource.data.lines is list
        && request.resource.data.lines.size() == request.resource.data.jobIds.size()
        && request.resource.data.lines[0].jobId == request.resource.data.jobIds[0]
        && request.resource.data.lines[0].taxRate in [0, 10]
        // 1明細のときは従来どおり明細金額と合計の一致まで見る。複数明細は合計から
        // 内税を検算する（Rules はリストを合算できないため、明細ごとの合算は
        // オーナー承認時の _portalInvoiceCheck が再計算して確かめる）。
        && (request.resource.data.lines.size() != 1
          || request.resource.data.lines[0].amount == request.resource.data.total)
        && request.resource.data.invoiceAvailableOn is string
        && request.resource.data.invoiceAvailableOn.matches('^[0-9]{4}-[0-9]{2}-25$')
        && request.resource.data.paymentDueDate is string
        && request.resource.data.paymentDueDate.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && request.resource.data.issueDate == request.resource.data.invoiceAvailableOn
        && request.resource.data.dueDate == request.resource.data.paymentDueDate
        && request.resource.data.subtotal > 0
        && request.resource.data.tax >= 0
        && request.resource.data.total == request.resource.data.subtotal + request.resource.data.tax
        && ((request.resource.data.lines[0].taxRate == 0 && request.resource.data.tax == 0)
          || (request.resource.data.lines[0].taxRate == 10
            && request.resource.data.tax == int((request.resource.data.total * 10 + 55) / 110)))
        && request.resource.data.taxByRate is map
        && request.resource.data.taxByRate.size() == 1
        && ((request.resource.data.lines[0].taxRate == 0 && request.resource.data.taxByRate.get('0', -1) == request.resource.data.tax)
          || (request.resource.data.lines[0].taxRate == 10 && request.resource.data.taxByRate.get('10', -1) == request.resource.data.tax))
        && (request.resource.data.version == 1
          || (request.resource.data.supersedesInvoiceId is string
            && exists(invoicePath(uid, request.resource.data.supersedesInvoiceId))
            && get(invoicePath(uid, request.resource.data.supersedesInvoiceId)).data.editorUid == uid
            && get(invoicePath(uid, request.resource.data.supersedesInvoiceId)).data.authorizationId == 'manual'
            && get(invoicePath(uid, request.resource.data.supersedesInvoiceId)).data.status == '差戻し'
            && get(invoicePath(uid, request.resource.data.supersedesInvoiceId)).data.version + 1 == request.resource.data.version));
    }

    function validCompletedJobEvidence() {
      return request.resource.data.status != '完了'
        || (request.resource.data.evidenceUrl is string
          && request.resource.data.evidenceUrl.matches('^https?://.+')
          && request.resource.data.blocker is string
          && request.resource.data.blocker.size() == 0);
    }

    function validSubtaskIndex(data) {
      return !('subtaskIndex' in data)
        || (data.subtaskIndex is int && data.subtaskIndex >= 0 && data.subtaskIndex < 500);
    }

    // `deliveryDate` remains the promised deadline.  The actual completion
    // date is separate.  Old synchronized cases may not have had a promised
    // deadline, so only `legacy_sync` records may preserve an empty value.
    function validCompletedDeliveryDate() {
      return !('completedDeliveryDate' in request.resource.data)
        || validOptionalIsoDate(request.resource.data.completedDeliveryDate);
    }

    function validOptionalIsoDate(value) {
      return value is string
        && (value == '' || value.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$'));
    }

    function validJobSchedule() {
      let delivery = request.resource.data.get('deliveryDate', request.resource.data.get('deadline', ''));
      // A direct-client dispatch records the actual delivery date only after
      // delivery.  It therefore has no promised delivery date at creation.
      // Legacy synchronization has the same compatibility exception.
      let sourceWithoutDeadline = request.resource.data.get('source', '') in ['legacy_sync', 'direct_client'];
      return validOptionalIsoDate(request.resource.data.get('sharedDate', ''))
        && validOptionalIsoDate(request.resource.data.get('editorDraftDate', ''))
        && validOptionalIsoDate(request.resource.data.get('clientDraftDate', ''))
        && validOptionalIsoDate(request.resource.data.get('thumbnailDate', ''))
        && (delivery != '' || sourceWithoutDeadline)
        && validOptionalIsoDate(delivery)
        && validCompletedDeliveryDate()
        && request.resource.data.get('deadline', delivery) == delivery;
    }

    // The amount entered by an editor for a self-registered dispatch is the
    // editor payment, not the client price.  Client price and profit stay in
    // the owner-only pricing/ledger records.
    function validEditorPayAmountForCreate() {
      let source = request.resource.data.get('source', '');
      return source != 'direct_client'
        || (request.resource.data.get('businessType', '') == 'dispatch'
          && ('editorPayAmount' in request.resource.data)
          && request.resource.data.editorPayAmount is int
          && request.resource.data.editorPayAmount > 0
          && request.resource.data.editorPayAmount <= 100000000);
    }

    // New cases explicitly choose who sets the editor's first-draft date.
    // Missing values are treated as editor-owned only for legacy documents.
    function validEditorDraftDateAssignment(data) {
      let setter = data.get('editorDraftDateSetter', 'editor');
      return setter in ['creator', 'editor']
        && (setter != 'creator' || data.get('editorDraftDate', '') != '');
    }

    // Case documents keep only references to readable manuals, never their
    // body or URL.  Each child receives its effective fallback list/text.
    function validCaseManualLinks(data) {
      return data.get('manualIds', []) is list
        && data.get('manualIds', []).size() <= 20
        && data.get('parentManualIds', []) is list
        && data.get('parentManualIds', []).size() <= 20
        && data.get('caution', '') is string
        && data.get('caution', '').size() <= 2000
        && data.get('parentCaution', '') is string
        && data.get('parentCaution', '').size() <= 2000;
    }

    // Manager workflow actions do not rewrite scheduling, manual, attachment,
    // or subtask metadata. Revalidate a group only when this request changes
    // one of its fields; unchanged legacy values remain readable and the
    // workflow check stays within Firestore's expression budget.
    function validManagerJobShapeUpdate(data) {
      let changed = request.resource.data.diff(resource.data).affectedKeys();
      return (!changed.hasAny([
          'sharedDate','editorDraftDate','clientDraftDate','thumbnailDate',
          'deadline','deliveryDate','completedDeliveryDate','source'
        ]) || validJobSchedule())
        && (!changed.hasAny(['editorDraftDate','editorDraftDateSetter'])
          || validEditorDraftDateAssignment(data))
        && (!changed.hasAny(['manualIds','parentManualIds','caution','parentCaution'])
          || validCaseManualLinks(data))
        && (!changed.hasAny(['attachments']) || validAttachments(data))
        && (!changed.hasAny(['subtaskIndex']) || validSubtaskIndex(data));
    }

    function editorDraftDateChangeAllowed() {
      return resource.data.get('editorDraftDateSetter', 'editor') == 'editor'
        || request.resource.data.get('editorDraftDate', '') == resource.data.get('editorDraftDate', '');
    }

    function accessEnforced() {
      return exists(accessControlPath())
        && get(accessControlPath()).data.enforced == true;
    }

    function compatibilityAllowed() {
      return exists(accessControlPath())
        && 'compatibilityEmails' in get(accessControlPath()).data
        && get(accessControlPath()).data.compatibilityEmails is list
        && ((request.auth.token.email is string
          && get(accessControlPath()).data.compatibilityEmails is list
          && request.auth.token.email in get(accessControlPath()).data.compatibilityEmails)
          || approved(request.auth.uid));
    }

    function approved(uid) {
      return signedIn()
        && exists(accessPath(uid))
        && get(accessPath(uid)).data.approved == true
        && get(accessPath(uid)).data.roles is list;
    }

    function hasRole(uid, role) {
      return approved(uid) && get(accessPath(uid)).data.roles.hasAny([role]);
    }

    function editorKind(uid) {
      return get(accessPath(uid)).data.get('editorKind', 'direct');
    }

    function self(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    function editor(uid) {
      // Read the access row once. Calling hasRole twice repeated approved(),
      // exists(), and get() for the hottest portal/board paths.
      return self(uid)
        && exists(accessPath(uid))
        && get(accessPath(uid)).data.get('approved', false) == true
        && get(accessPath(uid)).data.get('roles', []) is list
        && get(accessPath(uid)).data.get('roles', []).hasAny([
          '動画編集者','動画編集ディレクター'
        ]);
    }

    // Push subscriptions are an account-private device capability, rather
    // than an editor-portal capability.  In particular, the owner can use
    // the owner app before an editor_portals/{uid} document exists.
    function pushDeviceOwner(uid) {
      return self(uid) && (owner()
        || hasRole(uid, '動画編集者')
        || hasRole(uid, '動画編集ディレクター'));
    }

    function pureEditor(uid) {
      return signedIn()
        && exists(accessPath(uid))
        && get(accessPath(uid)).data.roles is list
        && get(accessPath(uid)).data.roles.hasAny(['動画編集者'])
        && !get(accessPath(uid)).data.roles.hasAny([
          '動画編集ディレクター',
          'AIコンサルタント',
          'AIエンジニア',
          'Webデザイナー',
          '営業',
          'SNSマーケター'
        ]);
    }

    function coreStaff() {
      return signedIn()
        && !pureEditor(request.auth.uid)
        // A director's external editor may also hold a legacy second role.
        // That must never unlock the financial monolith through coreStaff.
        && (!exists(accessPath(request.auth.uid))
          || editorKind(request.auth.uid) != 'external')
        && (
          // Compatibility phase preserves the current app while every existing
          // member is assigned a UID-backed role. Explicitly revoked accounts
          // never receive this fallback.
          (!accessEnforced()
            && compatibilityAllowed()
            && (!exists(accessPath(request.auth.uid))
              || get(accessPath(request.auth.uid)).data.approved != false))
          || (approved(request.auth.uid)
            && get(accessPath(request.auth.uid)).data.roles.hasAny([
              '動画編集ディレクター',
              'AIコンサルタント',
              'AIエンジニア',
              'Webデザイナー',
              '営業',
              'SNSマーケター'
            ]))
        );
    }

    // Video directors operate through their scoped editor portal.  They must
    // never receive the legacy company-wide monolith, even when they also hold
    // another core-staff role.  Keep `coreStaff` unchanged because it remains
    // the authorization source for non-financial operational surfaces.
    function legacyMonolithStaff() {
      return coreStaff()
        && !hasRole(request.auth.uid, '動画編集ディレクター');
    }

    // Once Stage 2 marks shared/mcapp, stale owner/core tabs must not put the
    // removed legacy amount fields back by saving an old `jobs` payload. A
    // current client deliberately changes the nonce on every permitted jobs
    // write and acknowledges the current restore token. Updates that leave
    // jobs untouched remain available to owner/core.
    function migratedLegacyJobsWriteAllowed() {
      let nonce = request.resource.data.get('legacyFinanceWriteNonce', '');
      let ack = request.resource.data.get('legacyFinanceRestoreAck', '');
      let restoreToken = resource.data.get('ledgerRestoreToken', '');
      return !('ownerLegacyFinanceMigrationAt' in resource.data)
        || request.resource.data.get('jobs', null) == resource.data.get('jobs', null)
        || (nonce is string
          && nonce.size() > 0
          && nonce.size() <= 160
          && nonce != resource.data.get('legacyFinanceWriteNonce', '')
          && restoreToken is string
          && restoreToken.size() > 0
          && restoreToken.size() <= 160
          && ack is string
          && ack.size() > 0
          && ack.size() <= 160
          && ack == restoreToken
          // A v24-v28 merge inherits the stored acknowledgement but replaces
          // this nonce with a bare UUID. Only a client that received the
          // current token can produce the required token-prefixed nonce.
          && nonce.matches('^' + restoreToken + ':[A-Za-z0-9-]+$'));
    }

    function videoManager() {
      return owner() || (approved(request.auth.uid)
        && !pureEditor(request.auth.uid)
        && hasRole(request.auth.uid, '動画編集ディレクター'));
    }

    // An external editor is employed by a video director, not by mono.create.
    // Their portal must therefore never become a transport for the director's
    // mono.create settlement amount.
    function externalEditor(uid) {
      // Judge the portal owner, not the caller. A director updating an
      // external editor's job is not `self(uid)`, but the target still must
      // remain free of mono.create settlement fields.
      return approved(uid) && editorKind(uid) == 'external';
    }

    // Firestore Rules cannot redact individual fields. If a legacy external
    // portal job contains any settlement field, fail closed for that editor
    // until an owner removes/migrates those fields into a director-only record.
    function containsExternalSettlement(data) {
      return 'ownPay' in data
        || 'payableApproved' in data
        || 'payableApprovedAt' in data
        || 'payableMonth' in data;
    }

    function scopedVideoDirectorFor(uid) {
      // `hasRole(..., 動画編集ディレクター)` already proves this caller is
      // not a pure editor. Spell the equivalent check once here so a normal
      // workflow update stays below the Rules engine expression limit.
      return signedIn()
        && exists(accessPath(request.auth.uid))
        && get(accessPath(request.auth.uid)).data.approved == true
        && get(accessPath(request.auth.uid)).data.roles is list
        && get(accessPath(request.auth.uid)).data.roles.hasAny(['動画編集ディレクター'])
        && exists(accessPath(uid))
        && get(accessPath(uid)).data.get('directorUid', '') == request.auth.uid;
    }

    function directorFor(uid) {
      return owner() || scopedVideoDirectorFor(uid);
    }

    function portalManager(uid) {
      return directorFor(uid);
    }

    // Master auto-sync is limited to mono.create-direct editors in the UI.
    // The owner may still share one catalog explicitly, and a director may
    // share only with an external editor assigned to that director.
    function catalogManager(uid) {
      return owner()
        || (videoManager()
          && exists(accessPath(uid))
          && editorKind(uid) == 'external'
          && get(accessPath(uid)).data.get('directorUid', '') == request.auth.uid);
    }

    // Master-client synchronization carries a former-name trail so a rename
    // does not create a second catalog entry. Keep that trail bounded and
    // typed; Firestore Rules cannot iterate a list's entries, so the UI also
    // normalizes each value before this write reaches the rule.
    function validClientCatalogDocument() {
      return request.resource.data.keys().hasOnly([
          'sourceClientId','name','formerNames','accounts','active','manualIds','updatedAt','updatedBy'
        ])
        && request.resource.data.get('sourceClientId', '') is string
        && request.resource.data.get('sourceClientId', '').size() <= 160
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.name.size() <= 100
        && request.resource.data.get('formerNames', []) is list
        && request.resource.data.get('formerNames', []).size() <= 100
        && request.resource.data.accounts is list
        && request.resource.data.accounts.size() <= 100
        && request.resource.data.get('active', true) is bool
        && request.resource.data.get('manualIds', []) is list
        && request.resource.data.get('manualIds', []).size() <= 100
        && request.resource.data.get('updatedBy', '') is string
        && request.resource.data.get('updatedBy', '').size() <= 320;
    }

    function validOwnerClientPricingDocument() {
      let defaultPrice = request.resource.data.get('defaultClientUnitPrice', null);
      return request.resource.data.keys().hasOnly([
          'recordType','clientSource','sourceClientId','clientName',
          'defaultClientUnitPrice','accountUnitPrices','revision','updatedAt','updatedBy'
        ])
        && request.resource.data.recordType == 'owner_client_pricing'
        && request.resource.data.clientSource in ['projects','crm']
        && request.resource.data.sourceClientId is string
        && request.resource.data.sourceClientId.size() > 0
        && request.resource.data.sourceClientId.size() <= 160
        && request.resource.data.clientName is string
        && request.resource.data.clientName.size() <= 100
        && (defaultPrice == null
          || (defaultPrice is int && defaultPrice >= 0 && defaultPrice <= 100000000))
        && request.resource.data.accountUnitPrices is map
        && request.resource.data.accountUnitPrices.size() <= 100
        && request.resource.data.revision is int
        && request.resource.data.revision >= 1
        && request.resource.data.updatedBy is string
        && request.resource.data.updatedBy.size() <= 320;
    }

    // Effective-dated, owner-only rates are the source for new dispatch
    // finance rows.  Scope and start date are immutable so an audit trail is
    // never silently rewritten; corrections advance the revision instead.
    function validOwnerClientRateDocument() {
      return request.resource.data.keys().hasOnly([
          'recordType','clientSource','sourceClientId','clientName','accountId','accountName',
          'effectiveFrom','clientUnitPrice','editorPayAmount','active','revision',
          'createdAt','createdBy','updatedAt','updatedBy'
        ])
        && request.resource.data.recordType == 'owner_client_rate'
        && request.resource.data.clientSource in ['projects','crm']
        && request.resource.data.sourceClientId is string
        && request.resource.data.sourceClientId.size() > 0
        && request.resource.data.sourceClientId.size() <= 160
        && request.resource.data.clientName is string
        && request.resource.data.clientName.size() > 0
        && request.resource.data.clientName.size() <= 100
        && request.resource.data.accountId is string
        && request.resource.data.accountId.size() <= 160
        && request.resource.data.accountName is string
        && request.resource.data.accountName.size() <= 100
        && request.resource.data.effectiveFrom is string
        && request.resource.data.effectiveFrom.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && request.resource.data.clientUnitPrice is int
        && request.resource.data.clientUnitPrice > 0
        && request.resource.data.clientUnitPrice <= 100000000
        && request.resource.data.editorPayAmount is int
        && request.resource.data.editorPayAmount >= 0
        && request.resource.data.editorPayAmount <= 100000000
        && request.resource.data.active is bool
        && request.resource.data.revision is int
        && request.resource.data.revision >= 1
        && request.resource.data.createdAt is timestamp
        && request.resource.data.createdBy is string
        && request.resource.data.createdBy.size() > 0
        && request.resource.data.createdBy.size() <= 320
        && request.resource.data.updatedAt is timestamp
        && request.resource.data.updatedBy is string
        && request.resource.data.updatedBy.size() > 0
        && request.resource.data.updatedBy.size() <= 320;
    }

    function validOwnerClientRateUpdate() {
      return validOwnerClientRateDocument()
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.createdBy == resource.data.createdBy
        && request.resource.data.clientSource == resource.data.clientSource
        && request.resource.data.sourceClientId == resource.data.sourceClientId
        && request.resource.data.clientName == resource.data.clientName
        && request.resource.data.accountId == resource.data.accountId
        && request.resource.data.accountName == resource.data.accountName
        && request.resource.data.effectiveFrom == resource.data.effectiveFrom
        && request.resource.data.revision == resource.data.revision + 1
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'clientUnitPrice','editorPayAmount','active','revision','updatedAt','updatedBy'
        ]);
    }

    function validOwnerJobFinanceDocument() {
      let masterPrice = request.resource.data.get('masterClientUnitPrice', null);
      let assigneePath = accessPath(request.resource.data.portalUid);
      let payeePath = accessPath(request.resource.data.payeeUid);
      let assignee = get(assigneePath).data;
      let payee = get(payeePath).data;
      return request.resource.data.keys().hasOnly([
          'recordType','portalUid','portalJobId','legacyJobId','parentCaseId',
          'sourceClientId','accountId','clientUnitPrice','masterClientUnitPrice',
          'pricingSource','pricingRevision','pricingUpdatedAt','pricingRateId','pricingEffectiveFrom','overrideReason',
          'editorPayReference','approvedPayAmount','payRoute','payeeUid',
          'payeeWorkerId','assigneeUid','assigneeWorkerId','approvedBy',
          'approvedAt','updatedAt'
        ])
        && request.resource.data.recordType == 'owner_job_finance'
        // Reject pricing-source and payee-routing violations before validating
        // descriptive fields. These are the authorization boundary and were
        // previously late enough that a bad row could hit 1,000 expressions
        // before returning false.
        && request.resource.data.pricingSource in ['master','account_master','client_schedule','account_schedule','case_override']
        && request.resource.data.overrideReason is string
        && request.resource.data.overrideReason.size() <= 500
        && (request.resource.data.pricingSource != 'case_override'
          || request.resource.data.overrideReason.size() > 0)
        && (!(request.resource.data.pricingSource in ['client_schedule','account_schedule'])
          || (request.resource.data.get('pricingRateId', '').size() > 0
            && request.resource.data.get('pricingEffectiveFrom', '').size() > 0))
        && exists(assigneePath)
        && assignee.get('approved', false) == true
        && assignee.get('roles', []) is list
        && assignee.get('roles', []).hasAny(['動画編集者','動画編集ディレクター'])
        && ((assignee.get('editorKind', 'direct') == 'external'
            && request.resource.data.payRoute == 'director_team'
            && request.resource.data.payeeUid == assignee.get('directorUid', '')
            && exists(payeePath)
            && payee.get('approved', false) == true
            && payee.get('roles', []) is list
            && payee.get('roles', []).hasAny(['動画編集ディレクター'])
            && payee.get('workerId', '') == request.resource.data.get('payeeWorkerId', ''))
          || (assignee.get('editorKind', 'direct') != 'external'
            && request.resource.data.payRoute == 'direct'
            && request.resource.data.payeeUid == request.resource.data.portalUid
            && request.resource.data.get('payeeWorkerId', '') == request.resource.data.get('assigneeWorkerId', '')))
        && request.resource.data.portalUid is string
        && request.resource.data.portalUid.size() > 0
        && request.resource.data.portalUid.size() <= 160
        && request.resource.data.portalJobId is string
        && request.resource.data.portalJobId.size() > 0
        && request.resource.data.portalJobId.size() <= 220
        && request.resource.data.legacyJobId is string
        && request.resource.data.legacyJobId.size() > 0
        && request.resource.data.legacyJobId.size() <= 220
        && request.resource.data.get('parentCaseId', '') is string
        && request.resource.data.get('parentCaseId', '').size() <= 160
        && request.resource.data.sourceClientId is string
        && request.resource.data.sourceClientId.size() > 0
        && request.resource.data.sourceClientId.size() <= 160
        && request.resource.data.get('accountId', '') is string
        && request.resource.data.get('accountId', '').size() <= 160
        && request.resource.data.clientUnitPrice is int
        && request.resource.data.clientUnitPrice > 0
        && request.resource.data.clientUnitPrice <= 100000000
        && (masterPrice == null
          || (masterPrice is int && masterPrice >= 0 && masterPrice <= 100000000))
        && request.resource.data.pricingRevision is int
        && request.resource.data.pricingRevision >= 0
        && (request.resource.data.get('pricingUpdatedAt', null) == null
          || request.resource.data.pricingUpdatedAt is timestamp)
        && request.resource.data.get('pricingRateId', '') is string
        && request.resource.data.get('pricingRateId', '').size() <= 220
        && request.resource.data.get('pricingEffectiveFrom', '') is string
        && (request.resource.data.get('pricingEffectiveFrom', '') == ''
          || request.resource.data.get('pricingEffectiveFrom', '').matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$'))
        && request.resource.data.editorPayReference is int
        && request.resource.data.editorPayReference > 0
        && request.resource.data.editorPayReference <= 100000000
        && request.resource.data.approvedPayAmount is int
        && request.resource.data.approvedPayAmount > 0
        && request.resource.data.approvedPayAmount <= 100000000
        && request.resource.data.payRoute in ['direct','director_team']
        && request.resource.data.payeeUid is string
        && request.resource.data.payeeUid.size() > 0
        && request.resource.data.payeeUid.size() <= 160
        && request.resource.data.get('payeeWorkerId', '') is string
        && request.resource.data.get('payeeWorkerId', '').size() <= 160
        && request.resource.data.assigneeUid is string
        && request.resource.data.assigneeUid.size() > 0
        && request.resource.data.assigneeUid.size() <= 160
        && request.resource.data.assigneeUid == request.resource.data.portalUid
        && request.resource.data.get('assigneeWorkerId', '') is string
        && request.resource.data.get('assigneeWorkerId', '').size() <= 160
        && assignee.get('workerId', '') == request.resource.data.get('assigneeWorkerId', '')
        && request.resource.data.approvedBy is string
        && request.resource.data.approvedBy.size() > 0
        && request.resource.data.approvedBy.size() <= 320
        && request.resource.data.approvedAt is timestamp
        && request.resource.data.updatedAt is timestamp;
    }

    // The confirmed source record remains unchanged. Owners may keep a current
    // amount snapshot on the same private document so a case price can be
    // corrected from the normal case editor without exposing it to editors.
    function validOwnerJobFinanceUpdate() {
      return request.resource.data.currentClientUnitPrice is int
        && request.resource.data.currentClientUnitPrice >= 0
        && request.resource.data.currentClientUnitPrice <= 100000000
        && request.resource.data.currentApprovedPayAmount is int
        && request.resource.data.currentApprovedPayAmount >= 0
        && request.resource.data.currentApprovedPayAmount <= 100000000
        && request.resource.data.revision is int
        && request.resource.data.revision == resource.data.get('revision', 0) + 1
        && request.resource.data.updatedAt is timestamp
        && request.resource.data.updatedAt == request.time
        && request.resource.data.updatedBy is string
        && request.resource.data.updatedBy == request.auth.token.email
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'currentClientUnitPrice','currentApprovedPayAmount','revision','updatedAt','updatedBy'
        ]);
    }

    function validOwnerDeliveryGoalBreakdown() {
      return request.resource.data.keys().hasAll([
          'internalTargetCount','internalTargetAmount',
          'agencyTargetCount','agencyTargetAmount',
          'dispatchTargetCount','dispatchTargetAmount'
        ])
        && request.resource.data.internalTargetCount is int && request.resource.data.internalTargetCount >= 0 && request.resource.data.internalTargetCount <= 1000000
        && request.resource.data.internalTargetAmount is int && request.resource.data.internalTargetAmount >= 0 && request.resource.data.internalTargetAmount <= 1000000000
        && request.resource.data.agencyTargetCount is int && request.resource.data.agencyTargetCount >= 0 && request.resource.data.agencyTargetCount <= 1000000
        && request.resource.data.agencyTargetAmount is int && request.resource.data.agencyTargetAmount >= 0 && request.resource.data.agencyTargetAmount <= 1000000000
        && request.resource.data.dispatchTargetCount is int && request.resource.data.dispatchTargetCount >= 0 && request.resource.data.dispatchTargetCount <= 1000000
        && request.resource.data.dispatchTargetAmount is int && request.resource.data.dispatchTargetAmount >= 0 && request.resource.data.dispatchTargetAmount <= 1000000000
        && request.resource.data.targetCount == request.resource.data.internalTargetCount + request.resource.data.agencyTargetCount + request.resource.data.dispatchTargetCount
        && request.resource.data.targetAmount == request.resource.data.internalTargetAmount + request.resource.data.agencyTargetAmount + request.resource.data.dispatchTargetAmount;
    }

    function validOwnerDeliveryGoal() {
      return request.resource.data.keys().hasOnly([
          'recordType','month','targetCount','targetAmount','active','revision',
          'internalTargetCount','internalTargetAmount',
          'agencyTargetCount','agencyTargetAmount',
          'dispatchTargetCount','dispatchTargetAmount',
          'createdAt','createdBy','updatedAt','updatedBy'
        ])
        && request.resource.data.recordType == 'owner_delivery_goal'
        && request.resource.data.month is string
        && request.resource.data.month.matches('^[0-9]{4}-[0-9]{2}$')
        && request.resource.data.targetCount is int && request.resource.data.targetCount >= 0 && request.resource.data.targetCount <= 1000000
        && request.resource.data.targetAmount is int && request.resource.data.targetAmount >= 0 && request.resource.data.targetAmount <= 1000000000
        && (!request.resource.data.keys().hasAny([
              'internalTargetCount','internalTargetAmount',
              'agencyTargetCount','agencyTargetAmount',
              'dispatchTargetCount','dispatchTargetAmount'
            ]) || validOwnerDeliveryGoalBreakdown())
        && request.resource.data.active is bool
        && request.resource.data.revision is int && request.resource.data.revision >= 1
        && request.resource.data.createdAt is timestamp && request.resource.data.createdBy is string && request.resource.data.createdBy.size() > 0 && request.resource.data.createdBy.size() <= 320
        && request.resource.data.updatedAt is timestamp && request.resource.data.updatedBy is string && request.resource.data.updatedBy.size() > 0 && request.resource.data.updatedBy.size() <= 320;
    }

    function validOwnerDeliveryGoalUpdate() {
      return validOwnerDeliveryGoal()
        && request.resource.data.month == resource.data.month
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.createdBy == resource.data.createdBy
        && request.resource.data.revision == resource.data.revision + 1
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'targetCount','targetAmount','internalTargetCount','internalTargetAmount',
          'agencyTargetCount','agencyTargetAmount','dispatchTargetCount','dispatchTargetAmount',
          'active','revision','updatedAt','updatedBy'
        ]);
    }

    function validOwnerDailyDeliveryCheck() {
      let summary = request.resource.data.summary;
      return request.resource.data.keys().hasOnly([
          'recordType','date','confirmed','confirmedAt','confirmedBy','summary'
        ])
        && request.resource.data.recordType == 'owner_daily_delivery_check'
        && request.resource.data.date is string && request.resource.data.date.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && request.resource.data.confirmed == true
        && request.resource.data.confirmedAt is timestamp
        && request.resource.data.confirmedBy is string && request.resource.data.confirmedBy.size() > 0 && request.resource.data.confirmedBy.size() <= 320
        && summary is map
        && summary.keys().hasOnly([
          'month','targetCount','targetAmount','actualCount','actualAmount','todayCount','todayAmount',
          'missingAmountCount','remainingCount','remainingAmount','sourceHash'
        ])
        && summary.keys().hasAll([
          'month','targetCount','targetAmount','actualCount','actualAmount','todayCount','todayAmount',
          'missingAmountCount','remainingCount','remainingAmount','sourceHash'
        ])
        && summary.month is string && summary.month.matches('^[0-9]{4}-[0-9]{2}$')
        && summary.targetCount is int && summary.targetCount >= 0 && summary.targetCount <= 1000000
        && summary.targetAmount is int && summary.targetAmount >= 0 && summary.targetAmount <= 1000000000
        && summary.actualCount is int && summary.actualCount >= 0 && summary.actualCount <= 1000000
        && summary.actualAmount is int && summary.actualAmount >= 0 && summary.actualAmount <= 1000000000
        && summary.todayCount is int && summary.todayCount >= 0 && summary.todayCount <= 1000000
        && summary.todayAmount is int && summary.todayAmount >= 0 && summary.todayAmount <= 1000000000
        && summary.missingAmountCount is int && summary.missingAmountCount == 0
        && summary.remainingCount is int && summary.remainingCount >= 0 && summary.remainingCount <= 1000000
        && summary.remainingAmount is int && summary.remainingAmount >= 0 && summary.remainingAmount <= 1000000000
        && summary.sourceHash is string && summary.sourceHash.size() > 0 && summary.sourceHash.size() <= 120;
    }

    function validOwnerQualityReview() {
      return request.resource.data.keys().hasOnly([
          'recordType','weekStart','editorUid','unitKey','score','note','active','revision',
          'createdAt','createdBy','updatedAt','updatedBy'
        ])
        && request.resource.data.recordType == 'owner_editor_quality_review'
        && request.resource.data.weekStart is string && request.resource.data.weekStart.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && request.resource.data.editorUid is string && request.resource.data.editorUid.size() > 0 && request.resource.data.editorUid.size() <= 160
        && request.resource.data.unitKey is string && request.resource.data.unitKey.size() > 0 && request.resource.data.unitKey.size() <= 300
        && request.resource.data.score is int && request.resource.data.score >= 1 && request.resource.data.score <= 5
        && request.resource.data.note is string && request.resource.data.note.size() <= 2000
        && request.resource.data.active is bool
        && request.resource.data.revision is int && request.resource.data.revision >= 1
        && request.resource.data.createdAt is timestamp && request.resource.data.createdBy is string && request.resource.data.createdBy.size() > 0 && request.resource.data.createdBy.size() <= 320
        && request.resource.data.updatedAt is timestamp && request.resource.data.updatedBy is string && request.resource.data.updatedBy.size() > 0 && request.resource.data.updatedBy.size() <= 320;
    }

    function validOwnerQualityReviewUpdate() {
      return validOwnerQualityReview()
        && request.resource.data.weekStart == resource.data.weekStart
        && request.resource.data.editorUid == resource.data.editorUid
        && request.resource.data.unitKey == resource.data.unitKey
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.createdBy == resource.data.createdBy
        && request.resource.data.revision == resource.data.revision + 1
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'score','note','active','revision','updatedAt','updatedBy'
        ]);
    }

    function validEditorWeeklyRanking() {
      // Each sanitized row is produced by the owner module and contains only
      // editorUid/editorName/rank/delivered/onTimeRate/averageQuality/
      // qualityEvaluationRate/qualityEvaluationCount/score. Rules cannot
      // iterate a list of maps, so keep the envelope bounded here.
      return request.resource.data.keys().hasOnly([
          'recordType','weekStart','rows','revision','updatedAt','updatedBy'
        ])
        && request.resource.data.recordType == 'editor_weekly_ranking'
        && request.resource.data.weekStart is string && request.resource.data.weekStart.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && request.resource.data.rows is list && request.resource.data.rows.size() <= 200
        && request.resource.data.revision is int && request.resource.data.revision >= 1
        && request.resource.data.updatedAt is timestamp
        && request.resource.data.updatedBy is string && request.resource.data.updatedBy.size() > 0 && request.resource.data.updatedBy.size() <= 320;
    }

    // A one-time, owner-only copy of financial values that still exist in the
    // legacy shared ledger.  Per-subtask row validation is intentionally done
    // by the migration CLI: Firestore Rules cannot safely iterate a 500-row
    // list, so Rules only enforce the envelope, identity, and parent amounts.
    function validOwnerLegacyFinanceDocument(financeId) {
      let amounts = request.resource.data.get('parentAmounts', {});
      return request.resource.data.keys().hasOnly([
          'recordType','legacyJobId','sourceHash','parentAmounts','subtaskAmounts',
          'revision','migratedAt','migratedBy'
        ])
        && request.resource.data.recordType == 'owner_legacy_finance'
        && request.resource.data.legacyJobId is string
        && request.resource.data.legacyJobId.size() > 0
        && request.resource.data.legacyJobId.size() <= 220
        && request.resource.data.legacyJobId == financeId
        && request.resource.data.sourceHash is string
        && request.resource.data.sourceHash.matches('^[0-9a-fA-F]{64}$')
        && amounts is map
        && amounts.keys().hasOnly(['unitPrice','workerPay','profit','monthlyFee','salesPay'])
        && amounts.keys().hasAll(['unitPrice','workerPay','profit','monthlyFee','salesPay'])
        && amounts.unitPrice is int && amounts.unitPrice >= 0 && amounts.unitPrice <= 100000000
        && amounts.workerPay is int && amounts.workerPay >= 0 && amounts.workerPay <= 100000000
        && amounts.profit is int && amounts.profit >= 0 && amounts.profit <= 100000000
        && amounts.monthlyFee is int && amounts.monthlyFee >= 0 && amounts.monthlyFee <= 100000000
        && amounts.salesPay is int && amounts.salesPay >= 0 && amounts.salesPay <= 100000000
        && request.resource.data.subtaskAmounts is list
        && request.resource.data.subtaskAmounts.size() <= 500
        && request.resource.data.revision is int
        && request.resource.data.revision >= 1
        && request.resource.data.migratedAt is timestamp
        && request.resource.data.migratedBy is string
        && request.resource.data.migratedBy.size() > 0
        && request.resource.data.migratedBy.size() <= 320;
    }

    function validOwnerLegacyCurrentParentAmounts() {
      let amounts = request.resource.data.currentParentAmounts;
      return amounts is map
        && amounts.keys().hasOnly(['unitPrice','workerPay','profit','monthlyFee','salesPay'])
        && amounts.keys().hasAll(['unitPrice','workerPay','profit','monthlyFee','salesPay'])
        && amounts.unitPrice is int && amounts.unitPrice >= 0 && amounts.unitPrice <= 100000000
        && amounts.workerPay is int && amounts.workerPay >= 0 && amounts.workerPay <= 100000000
        && amounts.profit is int && amounts.profit >= -100000000 && amounts.profit <= 100000000
        && amounts.monthlyFee is int && amounts.monthlyFee >= 0 && amounts.monthlyFee <= 100000000
        && amounts.salesPay is int && amounts.salesPay >= 0 && amounts.salesPay <= 100000000;
    }

    // Migration originals stay immutable. Only the owner-editable current
    // snapshot and its revision metadata may advance.
    function validOwnerLegacyFinanceUpdate(financeId) {
      return request.resource.data.keys().hasOnly([
          'recordType','legacyJobId','sourceHash','parentAmounts','subtaskAmounts',
          'currentParentAmounts','currentSubtaskAmounts','revision','migratedAt','migratedBy',
          'updatedAt','updatedBy'
        ])
        && request.resource.data.recordType == resource.data.recordType
        && request.resource.data.legacyJobId == financeId
        && request.resource.data.legacyJobId == resource.data.legacyJobId
        && request.resource.data.sourceHash == resource.data.sourceHash
        && request.resource.data.parentAmounts == resource.data.parentAmounts
        && request.resource.data.subtaskAmounts == resource.data.subtaskAmounts
        && request.resource.data.migratedAt == resource.data.migratedAt
        && request.resource.data.migratedBy == resource.data.migratedBy
        && validOwnerLegacyCurrentParentAmounts()
        && request.resource.data.currentSubtaskAmounts is list
        && request.resource.data.currentSubtaskAmounts.size() <= 500
        && request.resource.data.revision is int
        && request.resource.data.revision == resource.data.revision + 1
        && request.resource.data.updatedAt is timestamp
        && request.resource.data.updatedAt == request.time
        && request.resource.data.updatedBy is string
        && request.resource.data.updatedBy == request.auth.token.email
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'currentParentAmounts','currentSubtaskAmounts','revision','updatedAt','updatedBy'
        ]);
    }

    // A correction is a new, immutable evidence-backed delta against one
    // migrated legacy subtask. Rules bind every correction to the immutable
    // source row; later revisions must point to the preceding append-only row.
    function validOwnerLegacyFinanceCorrectionDocument(correctionId) {
      let ledgerPath = /databases/$(database)/documents/owner_legacy_finance/$(request.resource.data.legacyFinanceId);
      let previousPath = /databases/$(database)/documents/owner_legacy_finance_corrections/$(request.resource.data.supersedesCorrectionId);
      let ledger = get(ledgerPath).data;
      let lines = ledger.get('subtaskAmounts', []);
      let index = request.resource.data.subtaskIndex;
      return request.resource.data.keys().hasOnly([
          'recordType','legacyFinanceId','legacyJobId','subtaskId','subtaskIndex',
          'originalTitleHash','originalWorkerPay','deltaWorkerPay','correctedWorkerPay',
          'reason','evidenceRef','approvedBy','approvedAt','revision','supersedesCorrectionId',
          'createdAt','createdBy'
        ])
        && request.resource.data.recordType == 'owner_legacy_finance_correction'
        && request.resource.data.legacyFinanceId is string && request.resource.data.legacyFinanceId.size() > 0 && request.resource.data.legacyFinanceId.size() <= 220
        && request.resource.data.legacyJobId is string && request.resource.data.legacyJobId.size() > 0 && request.resource.data.legacyJobId.size() <= 220
        && request.resource.data.legacyFinanceId == request.resource.data.legacyJobId
        && request.resource.data.subtaskId is string && request.resource.data.subtaskId.size() <= 220
        && request.resource.data.subtaskIndex is int && request.resource.data.subtaskIndex >= 0 && request.resource.data.subtaskIndex < 500
        && request.resource.data.originalTitleHash is string && request.resource.data.originalTitleHash.matches('^[0-9a-fA-F]{64}$')
        && request.resource.data.originalWorkerPay is int && request.resource.data.originalWorkerPay >= 0 && request.resource.data.originalWorkerPay <= 100000000
        && request.resource.data.deltaWorkerPay is int && request.resource.data.deltaWorkerPay >= -100000000 && request.resource.data.deltaWorkerPay <= 100000000
        && request.resource.data.correctedWorkerPay is int && request.resource.data.correctedWorkerPay >= 0 && request.resource.data.correctedWorkerPay <= 100000000
        && request.resource.data.correctedWorkerPay == request.resource.data.originalWorkerPay + request.resource.data.deltaWorkerPay
        && request.resource.data.reason is string && request.resource.data.reason.size() > 0 && request.resource.data.reason.size() <= 2000
        && request.resource.data.evidenceRef is string && request.resource.data.evidenceRef.size() > 0 && request.resource.data.evidenceRef.size() <= 1000
        && request.resource.data.approvedBy is string && request.resource.data.approvedBy.size() > 0 && request.resource.data.approvedBy.size() <= 320
        && request.resource.data.approvedBy == request.auth.token.email
        && request.resource.data.approvedAt is timestamp
        && request.resource.data.revision is int && request.resource.data.revision >= 1 && request.resource.data.revision <= 100000
        && request.resource.data.supersedesCorrectionId is string && request.resource.data.supersedesCorrectionId.size() <= 300
        && request.resource.data.createdAt is timestamp
        && request.resource.data.createdBy is string && request.resource.data.createdBy.size() > 0 && request.resource.data.createdBy.size() <= 320
        && request.resource.data.createdBy == request.auth.token.email
        && request.resource.data.approvedAt == request.time
        && request.resource.data.createdAt == request.time
        && exists(ledgerPath)
        && ledger.recordType == 'owner_legacy_finance'
        && ledger.legacyJobId == request.resource.data.legacyJobId
        && lines is list && index < lines.size()
        && lines[index].get('titleHash', '') == request.resource.data.originalTitleHash
        && lines[index].get('workerPay', -1) == request.resource.data.originalWorkerPay
        && (request.resource.data.subtaskId == '' || lines[index].get('id', '') == request.resource.data.subtaskId)
        && ((request.resource.data.revision == 1 && request.resource.data.supersedesCorrectionId == '')
          || (request.resource.data.revision > 1
            && request.resource.data.supersedesCorrectionId != correctionId
            && exists(previousPath)
            && get(previousPath).data.recordType == 'owner_legacy_finance_correction'
            && get(previousPath).data.legacyFinanceId == request.resource.data.legacyFinanceId
            && get(previousPath).data.legacyJobId == request.resource.data.legacyJobId
            && get(previousPath).data.subtaskIndex == request.resource.data.subtaskIndex
            && get(previousPath).data.originalTitleHash == request.resource.data.originalTitleHash
            && get(previousPath).data.originalWorkerPay == request.resource.data.originalWorkerPay
            && get(previousPath).data.revision == request.resource.data.revision - 1
            && get(previousPath).data.correctedWorkerPay != request.resource.data.correctedWorkerPay));
    }

    // A dispatch job's readable `ownPay` is only a legacy UI mirror. The
    // immutable owner-only ledger is the source of truth and must exist
    // before the job can be marked payable.
    function validDispatchPayableMirror(uid, jobId) {
      let legacyId = request.resource.data.get('linkedLegacyJobId', '');
      let financePath = /databases/$(database)/documents/owner_job_finance/$(legacyId);
      let finance = getAfter(financePath).data;
      return request.resource.data.get('businessType', '') != 'dispatch'
        || (!('ownPay' in request.resource.data)
          && request.resource.data.get('payableApproved', false) != true)
        || (legacyId is string
          && legacyId.size() > 0
          && existsAfter(financePath)
          && getAfter(financePath).data.portalUid == uid
          && getAfter(financePath).data.portalJobId == jobId
          && getAfter(financePath).data.legacyJobId == legacyId
          && request.resource.data.ownPay == finance.get('currentApprovedPayAmount', finance.approvedPayAmount)
          && request.resource.data.ownPay > 0);
    }

    // Route every portal-job update through exactly one intent. Firestore adds
    // the work of every matching `allow update` expression to the same
    // 1,000-expression request budget, even when the request must ultimately be
    // denied. Keeping nine overlapping update rules made malformed or stale UI
    // writes fail because the evaluator ran out of budget instead of because a
    // specific authorization check returned false.
    function portalUpdateEventType() {
      let events = reviewEvents(request.resource.data);
      return events is list && events.size() > 0
        ? events[events.size() - 1].get('type', '')
        : '';
    }

    function portalSettlementChanged() {
      return request.resource.data.diff(resource.data).affectedKeys().hasAny([
        'ownPay','payableApproved','payableApprovedAt','payableMonth'
      ]);
    }

    function validGuidedPortalUpdate(uid) {
      let changed = request.resource.data.diff(resource.data).affectedKeys();
      return !self(uid)
        && changed.hasOnly([
          'status','completedDeliveryDate','correctionReason','updatedAt','updatedBy',
          'history','workflow','progressEvents'
        ])
        && resource.data.status != request.resource.data.status
        && request.resource.data.get('history', []) is list
        && (owner() || scopedVideoDirectorFor(uid))
        && validJobStatus(request.resource.data.status)
        && validCompletedJobEvidence()
        && validCompletedDeliveryDate()
        && (hasReviewWorkflow(resource.data)
          ? validCurrentManagerReviewTransition()
          : validLegacyManagerReviewTransition())
        && preservesFinalJob();
    }

    function validManagerOverridePortalUpdate(uid) {
      let changed = request.resource.data.diff(resource.data).affectedKeys();
      return !self(uid)
        && changed.hasOnly([
          'status','completedDeliveryDate','correctionReason','evidenceUrl','updatedAt','updatedBy',
          'history','workflow','progressEvents'
        ])
        && resource.data.status != request.resource.data.status
        && request.resource.data.get('history', []) is list
        && (owner() || scopedVideoDirectorFor(uid))
        && validJobStatus(request.resource.data.status)
        && validCompletedJobEvidence()
        && validCompletedDeliveryDate()
        && validManagerStatusOverride()
        && preservesFinalJob();
    }

    function validOwnerSettlementCleanup() {
      return owner()
        && containsExternalSettlement(resource.data)
        && !containsExternalSettlement(request.resource.data)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'ownPay','payableApproved','payableApprovedAt','payableMonth',
          'updatedAt','updatedBy'
        ]);
    }

    function validOwnerSettlementPortalUpdate(uid, jobId) {
      let changed = request.resource.data.diff(resource.data).affectedKeys();
      return owner()
        && changed.hasOnly([
          'title','clientDisplay','deadline','sharedDate','editorDraftDate','editorDraftDateSetter',
          'clientDraftDate','thumbnailDate','deliveryDate','completedDeliveryDate','instructions','urgent','status',
          'correctionReason','updatedAt','updatedBy','history','ownPay',
          'payableApproved','payableApprovedAt','payableMonth',
          'linkedLegacyJobId','integratedAt','integratedBy',
          'workflow','progressEvents','attachments','requestUrl','sourceUrl','subtaskIndex',
          'manualIds','parentManualIds','caution','parentCaution'
        ])
        && request.resource.data.status == resource.data.status
        && reviewEventsUnchanged()
        && validJobStatus(request.resource.data.status)
        && validManagerJobShapeUpdate(request.resource.data)
        && validCompletedJobEvidence()
        && preservesFinalJob()
        && (!externalEditor(uid) || !containsExternalSettlement(request.resource.data))
        && (!('ownPay' in request.resource.data) || request.resource.data.ownPay >= 0)
        && (!('payableApproved' in request.resource.data) || request.resource.data.payableApproved != true
          || (request.resource.data.status == '完了'
            && request.resource.data.ownPay > 0
            && request.resource.data.payableMonth is string
            && validCompletedJobEvidence()))
        && validDispatchPayableMirror(uid, jobId);
    }

    function validEditorSubmissionPortalUpdate(uid, jobId) {
      return editor(uid)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'status','deadline','sharedDate','editorDraftDate','clientDraftDate',
          'thumbnailDate','deliveryDate','progress','evidenceUrl','blocker',
          'workDate','startTime','endTime','progressMilestones',
          'lastProgressChangedByUid','lastProgressChangedByEmail',
          'lastProgressChangedByRole','updatedAt','history','workflow','progressEvents'
        ])
        && request.resource.data.get('lastProgressChangedByUid', '') == uid
        && request.resource.data.get('lastProgressChangedByRole', '') == '担当編集者'
        && request.resource.data.get('progressMilestones', []) is list
        && request.resource.data.get('history', []) is list
        && editorDraftDateChangeAllowed()
        && validEditorReviewTransition(uid, jobId)
        && preservesFinalJob()
        && validJobSchedule();
    }

    function validEditorDeliveryPortalUpdate(uid, jobId) {
      return editor(uid)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'status','completedDeliveryDate','evidenceUrl','blocker','workflow',
          'progressEvents','lastProgressChangedByUid','lastProgressChangedByEmail',
          'lastProgressChangedByRole','updatedAt','history'
        ])
        && request.resource.data.get('lastProgressChangedByUid', '') == uid
        && request.resource.data.get('lastProgressChangedByRole', '') == '担当編集者'
        && validEditorDeliveryCompletion(uid, jobId)
        && preservesFinalJob();
    }

    function validOrdinaryEditorPortalUpdate(uid, jobId) {
      return editor(uid)
        && validJobStatus(request.resource.data.status)
        && validCompletedJobEvidence()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'status','deadline','sharedDate','editorDraftDate','clientDraftDate',
          'thumbnailDate','deliveryDate','completedDeliveryDate','progress','evidenceUrl','blocker',
          'workDate','startTime','endTime','progressMilestones',
          'lastProgressChangedByUid','lastProgressChangedByEmail',
          'lastProgressChangedByRole','updatedAt','history','workflow','progressEvents'
        ])
        && request.resource.data.get('lastProgressChangedByUid', uid) == uid
        && request.resource.data.get('lastProgressChangedByRole', '担当編集者') == '担当編集者'
        && request.resource.data.get('progressMilestones', []) is list
        && request.resource.data.get('history', []) is list
        && editorDraftDateChangeAllowed()
        && validEditorReviewTransition(uid, jobId)
        && validEditorWorkflowStatus()
        && preservesFinalJob()
        && validJobSchedule();
    }

    function validDirectorPortalUpdate(uid) {
      return scopedVideoDirectorFor(uid)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'title','clientDisplay','deadline','sharedDate','editorDraftDate','editorDraftDateSetter',
          'clientDraftDate','thumbnailDate','deliveryDate','completedDeliveryDate','instructions','urgent','status',
          'correctionReason','updatedAt','updatedBy','history',
          'workflow','progressEvents','attachments','requestUrl','sourceUrl',
          'manualIds','parentManualIds','caution','parentCaution'
        ])
        && validJobStatus(request.resource.data.status)
        && validManagerJobShapeUpdate(request.resource.data)
        && validCompletedJobEvidence()
        && validManagerReviewTransition()
        && preservesFinalJob()
        && !containsExternalSettlement(request.resource.data);
    }

    function validOwnerPortalUpdate(uid, jobId) {
      return owner()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'title','clientDisplay','deadline','sharedDate','editorDraftDate','editorDraftDateSetter',
          'clientDraftDate','thumbnailDate','deliveryDate','completedDeliveryDate','instructions','urgent','status',
          'correctionReason','updatedAt','updatedBy','history','ownPay',
          'payableApproved','payableApprovedAt','payableMonth',
          'linkedLegacyJobId','integratedAt','integratedBy',
          'workflow','progressEvents','attachments','requestUrl','sourceUrl','subtaskIndex',
          'manualIds','parentManualIds','caution','parentCaution'
        ])
        && validJobStatus(request.resource.data.status)
        && validManagerJobShapeUpdate(request.resource.data)
        && validCompletedJobEvidence()
        && validManagerReviewTransition()
        && preservesFinalJob()
        && (!externalEditor(uid) || !containsExternalSettlement(request.resource.data))
        && (!('ownPay' in request.resource.data) || request.resource.data.ownPay >= 0)
        && (!('payableApproved' in request.resource.data) || request.resource.data.payableApproved != true
          || (request.resource.data.status == '完了'
            && request.resource.data.ownPay > 0
            && request.resource.data.payableMonth is string
            && validCompletedJobEvidence()))
        && validDispatchPayableMirror(uid, jobId);
    }

    // 案件内チャットの新着控え。案件を開いていない相手にも新着を見せるため、送信者が
    // 自分の直近1件だけを案件ドキュメントへ書く。他の項目は従来どおり触れない。
    function validJobChatStamp(uid) {
      return (directorFor(uid) || editor(uid))
        && request.resource.data.get('lastMessageSenderUid', '') == request.auth.uid
        && request.resource.data.get('lastMessageAt', 0) is number
        && request.resource.data.get('lastMessageAt', 0) > 0
        && request.resource.data.get('lastMessagePreview', '') is string
        && request.resource.data.get('lastMessagePreview', '').size() <= 80;
    }

    function validPortalJobUpdate(uid, jobId) {
      let changed = request.resource.data.diff(resource.data).affectedKeys();
      let eventType = changed.hasAny(['progressEvents']) ? portalUpdateEventType() : '';
      return changed.hasOnly([
          'lastMessageAt','lastMessageSenderUid','lastMessagePreview','updatedAt'
        ]) ? validJobChatStamp(uid)
        : eventType in [
          'director_approved','director_revision_requested','client_submitted',
          'client_revision_requested','client_approved_completed'
        ] ? validGuidedPortalUpdate(uid)
        : eventType == 'manager_status_changed' ? validManagerOverridePortalUpdate(uid)
        : portalSettlementChanged() ? (
            containsExternalSettlement(resource.data)
              && !containsExternalSettlement(request.resource.data)
              ? validOwnerSettlementCleanup()
              : validOwnerSettlementPortalUpdate(uid, jobId)
          )
        : resource.data.status != request.resource.data.status
          && request.resource.data.status in ['初稿提出済み','修正稿提出済み']
          ? validEditorSubmissionPortalUpdate(uid, jobId)
        : resource.data.status != '完了' && request.resource.data.status == '完了'
          ? validEditorDeliveryPortalUpdate(uid, jobId)
        : self(uid) ? validOrdinaryEditorPortalUpdate(uid, jobId)
        : owner() ? validOwnerPortalUpdate(uid, jobId)
        : validDirectorPortalUpdate(uid);
    }

    function validOwnerLegacyPortalJobCreate(uid) {
      return owner()
        && exists(accessPath(uid))
        && get(accessPath(uid)).data.get('approved', false) == true
        && get(accessPath(uid)).data.get('roles', []) is list
        && get(accessPath(uid)).data.get('roles', []).hasAny([
          '動画編集者','動画編集ディレクター'
        ])
        && request.resource.data.keys().hasOnly([
          'recordType','businessType','title','caseName','parentCaseId','parentCaseName',
          'clientId','clientDisplay','accountId','accountDisplay','deadline','requestUrl','sourceUrl',
          'sharedDate','editorDraftDate','editorDraftDateSetter','clientDraftDate','thumbnailDate','deliveryDate',
          'instructions','urgent','status','progress','evidenceUrl','blocker',
          'workDate','startTime','endTime','submittedByUid','editorUid',
          'editorEmail','editorName','directorUid','source','createdAt','updatedAt','history',
          'attachments','legacyParentId','legacySubtaskId','subtaskIndex',
          'manualIds','parentManualIds','caution','parentCaution'
        ])
        && request.resource.data.recordType == 'editor_portal_job'
        && request.resource.data.get('source', '') == 'legacy_sync'
        && request.resource.data.submittedByUid == uid
        && request.resource.data.editorUid == uid
        && request.resource.data.editorEmail == get(accessPath(uid)).data.get('email', '')
        && request.resource.data.get('businessType', '') in ['dispatch','edit_agency']
        && request.resource.data.title is string
        && request.resource.data.title.size() > 0
        && request.resource.data.title.size() <= 120
        && request.resource.data.get('parentCaseId', '') is string
        && request.resource.data.get('parentCaseId', '').size() > 0
        && request.resource.data.get('parentCaseId', '').size() <= 160
        && request.resource.data.get('parentCaseName', '') is string
        && request.resource.data.get('parentCaseName', '').size() > 0
        && request.resource.data.get('parentCaseName', '').size() <= 120
        && request.resource.data.get('legacyParentId', '') is string
        && request.resource.data.get('legacyParentId', '').size() > 0
        && request.resource.data.get('legacySubtaskId', '') is string
        && request.resource.data.get('legacySubtaskId', '').size() > 0
        && request.resource.data.clientDisplay is string
        && request.resource.data.clientDisplay.size() > 0
        && request.resource.data.instructions is string
        && request.resource.data.instructions.size() <= 3000
        && validJobSchedule()
        && validEditorDraftDateAssignment(request.resource.data)
        && validCaseManualLinks(request.resource.data)
        && validCompletedJobEvidence()
        && validAttachments(request.resource.data)
        && validSubtaskIndex(request.resource.data)
        && request.resource.data.history is list
        && request.resource.data.history.size() == 1;
    }

    function approvedMember() {
      return signedIn() && approved(request.auth.uid);
    }

    function canSeeBoard(data) {
      return signedIn()
        && exists(accessPath(request.auth.uid))
        && get(accessPath(request.auth.uid)).data.get('approved', false) == true
        && get(accessPath(request.auth.uid)).data.get('roles', []) is list
        && get(accessPath(request.auth.uid)).data.get('roles', []).hasAny(['動画編集者','動画編集ディレクター'])
        && data.status == 'open'
        && (
          (data.get('audience', '') == 'direct'
            && get(accessPath(request.auth.uid)).data.get('editorKind', 'direct') != 'external')
          || (data.get('eligibleUids', []) is list
            && request.auth.uid in data.get('eligibleUids', []))
          || (get(accessPath(request.auth.uid)).data.get('editorKind', 'direct') == 'external'
            && data.get('directorUid', '') != ''
            && data.get('directorUid', '') == get(accessPath(request.auth.uid)).data.get('directorUid', ''))
        );
    }

    // A video-workspace document can contain client instructions, source URLs,
    // or availability details.  "approved" alone is not a sufficient reason
    // to read it: non-video staff must use their own scoped surfaces.
    function videoWorkspaceMember() {
      return owner() || (approvedMember()
        && get(accessPath(request.auth.uid)).data.roles.hasAny([
          '動画編集者','動画編集ディレクター'
        ]));
    }

    // Directors may publish only to one of their own external editors.  The
    // owner is the sole actor that can publish to the direct-editor pool.
    function validDirectorBoardAudience(data) {
      let targets = data.get('eligibleUids', []);
      return data.get('audience', '') == 'director_team'
        && data.get('directorUid', '') == request.auth.uid
        && targets is list
        && targets.size() == 1
        && exists(accessPath(targets[0]))
        && editorKind(targets[0]) == 'external'
        && get(accessPath(targets[0])).data.get('directorUid', '') == request.auth.uid;
    }

    // A director may correct the descriptive content of their still-open
    // listing, but may never republish it, transfer it, or alter its claim
    // state.  Those fields are authorization boundaries, not UI preferences.
    function validDirectorBoardUpdate() {
      return resource.data.get('directorUid', '') == request.auth.uid
        && validDirectorBoardAudience(resource.data)
        && validDirectorBoardAudience(request.resource.data)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'title','caseName','parentCaseName','clientName','accountName',
          'summary','instructions','requestUrl','sourceUrl','attachments',
          'manualIds','parentManualIds','caution','parentCaution',
          'editorDraftDate','editorDraftDateSetter','clientDraftDate',
          'thumbnailDate','deliveryDate','urgent','updatedAt'
        ]);
    }

    // A claimed board record is the authority for its portal projection.  Keep
    // this deliberately to identity, ownership, and finance-routing fields:
    // this function is evaluated beside the already-large portal-create
    // validator in one atomic claim, and a full text/URL/date copy comparison
    // exceeds the Rules engine's 1000-expression limit.  The omitted display
    // instructions, URLs, attachments, and dates are not finance/identity
    // inputs. They remain client-supplied operational content, not an
    // authorization boundary; later date/workflow edits use their dedicated
    // role-owned validators.
    // In particular, a claimant still cannot manufacture further portal
    // records from one accepted board job or change its team/client routing.
    function validClaimedBoardProjection(jobId) {
      let boardPath = /databases/$(database)/documents/editor_job_board/$(jobId);
      let before = get(boardPath).data;
      let board = getAfter(boardPath).data;
      return before.get('status', '') == 'open'
        && before.get('assignedUid', '') == ''
        && request.resource.data.get('boardJobId', '') == jobId
        && request.resource.data.get('businessType', '') == board.get('businessType', '')
        && request.resource.data.get('title', '') == board.get('title', '')
        && request.resource.data.get('caseName', '') == board.get('caseName', '')
        // Keep these fallbacks identical to editor-features.js claimBoardJob
        // so a legacy open board can be accepted without weakening the
        // projection identity or allowing a claimant to choose its own data.
        && request.resource.data.get('parentCaseId', '') == (board.get('parentCaseId', '') != '' ? board.get('parentCaseId', '') : jobId)
        && request.resource.data.get('parentCaseName', '') == (board.get('parentCaseName', '') != '' ? board.get('parentCaseName', '') : (board.get('caseName', '') != '' ? board.get('caseName', '') : board.get('title', '')))
        && request.resource.data.get('subtaskIndex', 0) == board.get('subtaskIndex', 0)
        && request.resource.data.get('clientId', '') == board.get('clientId', '')
        && request.resource.data.get('sourceClientId', '') == (board.get('sourceClientId', '') != '' ? board.get('sourceClientId', '') : board.get('clientId', ''))
        && request.resource.data.get('clientDisplay', '') == board.get('clientName', '')
        && request.resource.data.get('accountId', '') == board.get('accountId', '')
        && request.resource.data.get('accountDisplay', '') == board.get('accountName', '')
        && request.resource.data.get('directorUid', '') == board.get('directorUid', '')
        && request.resource.data.get('status', '') == 'アサイン済み'
        && board.get('status', '') == 'assigned'
        && board.get('assignedUid', '') == request.auth.uid;
    }

    function validJobStatus(status) {
      return status in [
        '案件掲載中','募集中','編集者決定','アサイン済み','受注済み','進行中','編集者進行中',
        '初稿提出済み','修正稿提出済み','D確認OK','先方確認中',
        '初稿完成','確認待ち','修正中','完了','キャンセル'
      ];
    }

    // The portal used a single status before review rounds were introduced.
    // `workflow` and `progressEvents` are deliberately optional so those saved
    // jobs can still be read and receive ordinary non-workflow updates.
    function validReviewWorkflow(data) {
      return !('workflow' in data)
        || (data.workflow is map
          && data.workflow.keys().hasOnly(['round', 'stage'])
          && data.workflow.round is int
          && data.workflow.round >= 0
          && data.workflow.stage in [
            'editing', 'director_review', 'client_submission',
            'client_review', 'delivered'
          ]);
    }

    function validProgressEvents(data) {
      return !('progressEvents' in data)
        || (data.progressEvents is list && data.progressEvents.size() <= 200);
    }

    // 添付はURL・種別・表示名をクライアントで正規化する。Rulesでは配列の各mapを
    // 反復検査できないため、保存件数と「編集者はこのキーを更新できない」境界をここで固定する。
    function validAttachments(data) {
      return !('attachments' in data)
        || (data.attachments is list && data.attachments.size() <= 20);
    }

    function reviewEvents(data) {
      return data.get('progressEvents', []);
    }

    function reviewEventsUnchanged() {
      return reviewEvents(request.resource.data) == reviewEvents(resource.data);
    }

    function appendsOneReviewEvent() {
      let before = reviewEvents(resource.data);
      let after = reviewEvents(request.resource.data);
      // Firestore Rules cannot compare a list prefix. `hasAll` plus a one-item
      // size increase prevents deletion/replacement of saved events, although
      // it cannot prove their original order. The client always appends.
      return before is list
        && after is list
        && after.size() == before.size() + 1
        && after.hasAll(before);
    }

    function lastReviewEventMatches(type, fromStage, toStage, round, status, role) {
      let events = reviewEvents(request.resource.data);
      let event = events[events.size() - 1];
      return event is map
        && event.get('type', '') == type
        && event.get('round', -1) == round
        && event.get('fromStage', '') == fromStage
        && event.get('toStage', '') == toStage
        && event.get('status', '') == status
        && event.get('byUid', '') == request.auth.uid
        && event.get('byRole', '') == role;
    }

    function validEditorSubmittedEvent(fromStage, round, status) {
      let events = reviewEvents(request.resource.data);
      let event = events[events.size() - 1];
      return request.resource.data.evidenceUrl is string
        && request.resource.data.evidenceUrl.matches('^https?://.+')
        && event is map
        && event.get('evidenceUrl', '') is string
        && event.get('evidenceUrl', '').matches('^https?://.+')
        && event.get('evidenceUrl', '') == request.resource.data.evidenceUrl
        && appendsOneReviewEvent()
        && lastReviewEventMatches(
          'editor_submitted', fromStage, 'director_review', round, status, '担当編集者'
        );
    }

    // Only an assigned editor's dispatch/direct-client job can be finalised
    // after the client-review stage. This is deliberately separate from the
    // director/owner completion path for edit-agency jobs.
    // A final editor delivery must atomically append the matching immutable
    // event document.  The fixed ID prevents a second event from being used
    // to satisfy a later/replayed parent update.
    function validEditorDeliveryCompletion(uid, jobId) {
      let event = reviewEvents(request.resource.data)[reviewEvents(request.resource.data).size() - 1];
      let deliveryEventPath = /databases/$(database)/documents/editor_portals/$(uid)/editor_jobs/$(jobId)/events/delivery-completion;
      let wasClientReview = (!hasReviewWorkflow(resource.data)
          && resource.data.status in ['先方確認中', '確認待ち'])
        || (hasReviewWorkflow(resource.data)
          && reviewStage(resource.data) == 'client_review');
      return (request.resource.data.get('businessType', '') == 'dispatch'
          || request.resource.data.get('source', '') == 'direct_client')
        && wasClientReview
        && hasReviewWorkflow(request.resource.data)
        && reviewStage(request.resource.data) == 'delivered'
        && reviewRound(request.resource.data) == (hasReviewWorkflow(resource.data) ? reviewRound(resource.data) : 1)
        && request.resource.data.status == '完了'
        && request.resource.data.get('completedDeliveryDate', '') is string
        && request.resource.data.completedDeliveryDate.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && validCompletedJobEvidence()
        && appendsOneReviewEvent()
        && lastReviewEventMatches('editor_delivery_completed', 'client_review', 'delivered', reviewRound(request.resource.data), '完了', '担当編集者')
        && event.get('completedDeliveryDate', '') == request.resource.data.completedDeliveryDate
        && event.get('evidenceUrl', '') == request.resource.data.evidenceUrl
        && existsAfter(deliveryEventPath)
        && getAfter(deliveryEventPath).data.keys().hasOnly([
          'at','type','byUid','byEmail','byRole','status','fromStage','toStage','round',
          'completedDeliveryDate','evidenceUrl'
        ])
        && getAfter(deliveryEventPath).data.type == 'editor_delivery_completed'
        && getAfter(deliveryEventPath).data.at is timestamp
        && getAfter(deliveryEventPath).data.byUid == request.auth.uid
        && getAfter(deliveryEventPath).data.byEmail is string
        && getAfter(deliveryEventPath).data.byEmail.size() <= 320
        && getAfter(deliveryEventPath).data.byRole == '担当編集者'
        && getAfter(deliveryEventPath).data.fromStage == 'client_review'
        && getAfter(deliveryEventPath).data.toStage == 'delivered'
        && getAfter(deliveryEventPath).data.round == reviewRound(request.resource.data)
        && getAfter(deliveryEventPath).data.status == '完了'
        && getAfter(deliveryEventPath).data.completedDeliveryDate == request.resource.data.completedDeliveryDate
        && getAfter(deliveryEventPath).data.evidenceUrl == request.resource.data.evidenceUrl;
    }

    function validEditorSubmissionStatus(previousStatus, nextStatus) {
      return (nextStatus == '初稿提出済み'
          && previousStatus == '編集者進行中')
        || (nextStatus == '修正稿提出済み' && previousStatus == '修正中');
    }

    // Jobs saved before the explicit 「編集者進行中」 state may still be on
    // the old initial-draft marker. This compatibility path is only used when
    // the stored job has no workflow yet; new workflow records use the strict
    // transition above.
    function validLegacyEditorSubmissionStatus(previousStatus, nextStatus) {
      return validEditorSubmissionStatus(previousStatus, nextStatus)
        || (nextStatus == '初稿提出済み'
          && previousStatus in ['進行中', '初稿完成']);
    }

    function validEditorStartTransition(previousStatus, nextStatus) {
      return nextStatus == '編集者進行中'
        && previousStatus in ['未着手', '受注済み', '進行中', 'アサイン済み'];
    }

    // These states are changed only by a role-owned workflow action.  Old
    // portal records may keep receiving ordinary metadata updates without a
    // workflow, but a manager must not turn one into a submitted/review/final
    // case merely by changing its raw status field.
    function workflowControlledStatus(status) {
      return status in [
        '編集者進行中', '初稿提出済み', '修正中', '修正稿提出済み',
        'D確認OK', '先方確認中', '完了'
      ];
    }

    function validLegacyManagerNonWorkflowUpdate() {
      return !hasReviewWorkflow(resource.data)
        && !hasReviewWorkflow(request.resource.data)
        && validJobStatus(request.resource.data.status)
        && reviewEventsUnchanged()
        && (request.resource.data.status == resource.data.status
          || !workflowControlledStatus(request.resource.data.status));
    }

    function managerEventRole() {
      // The portal stores role identifiers in English for manager events.
      // The actor check itself is still enforced by the calling directorFor /
      // owner rule, so a plain editor cannot claim either value.
      return owner() ? 'owner' : 'director';
    }

    function managerSelectableStatus(status) {
      return status in [
        'アサイン済み','進行中','編集者進行中','初稿提出済み','修正中',
        '修正稿提出済み','D確認OK','先方確認中','完了'
      ];
    }

    function managerWorkflowStageForStatus(status) {
      return status in ['初稿提出済み','修正稿提出済み'] ? 'director_review'
        : status == 'D確認OK' ? 'client_submission'
        : status == '先方確認中' ? 'client_review'
        : status == '完了' ? 'delivered'
        : 'editing';
    }

    function managerOverrideCurrentStage() {
      return hasReviewWorkflow(resource.data) ? reviewStage(resource.data)
        : resource.data.status == '完了' ? 'delivered'
        : resource.data.status == 'D確認OK' ? 'client_submission'
        : resource.data.status in ['先方確認中','確認待ち'] ? 'client_review'
        : resource.data.status in ['初稿提出済み','修正稿提出済み','FB待ち'] ? 'director_review'
        : 'editing';
    }

    function managerOverrideBaseRound() {
      return hasReviewWorkflow(resource.data)
        ? (reviewRound(resource.data) > 0 ? reviewRound(resource.data) : 1)
        : (resource.data.status == '修正中' ? 2 : 1);
    }

    function managerOverrideExpectedRound(status) {
      let base = managerOverrideBaseRound();
      return status == '初稿提出済み' ? 1
        : status == '修正稿提出済み' ? (base < 2 ? 2 : base)
        : status == '修正中' && resource.data.status != '修正中' ? base + 1
        : base;
    }

    function managerOverrideNeedsEvidence(status) {
      return status in ['初稿提出済み', '修正稿提出済み', '完了'];
    }

    function managerStatusOverrideRequested() {
      let events = reviewEvents(request.resource.data);
      return events is list
        && events.size() > 0
        && events[events.size() - 1].get('type', '') == 'manager_status_changed';
    }

    function validManagerStatusOverride() {
      let events = reviewEvents(request.resource.data);
      let event = events[events.size() - 1];
      let status = request.resource.data.status;
      let round = reviewRound(request.resource.data);
      return managerStatusOverrideRequested()
        && status != resource.data.status
        && managerSelectableStatus(status)
        && hasReviewWorkflow(request.resource.data)
        && validReviewWorkflow(request.resource.data)
        && validProgressEvents(request.resource.data)
        && reviewStage(request.resource.data) == managerWorkflowStageForStatus(status)
        && round == managerOverrideExpectedRound(status)
        && appendsOneReviewEvent()
        && lastReviewEventMatches(
          'manager_status_changed', managerOverrideCurrentStage(),
          managerWorkflowStageForStatus(status), round, status, managerEventRole()
        )
        && event.get('fromStatus', '') == resource.data.status
        && event.get('reason', '') is string
        && event.get('reason', '').size() > 0
        && event.get('reason', '').size() <= 2000
        && (!managerOverrideNeedsEvidence(status)
          || (request.resource.data.get('evidenceUrl', '') is string
            && request.resource.data.get('evidenceUrl', '').matches('^https?://.+')
            && event.get('evidenceUrl', '') == request.resource.data.get('evidenceUrl', '')))
        && (status != '完了'
          || (managerMayCompleteJob()
            && request.resource.data.get('completedDeliveryDate', '') is string
            && request.resource.data.get('completedDeliveryDate', '') != ''
            && event.get('completedDeliveryDate', '') == request.resource.data.get('completedDeliveryDate', '')
            && event.get('clientApprovalConfirmed', false) == true));
    }

    function validManagerProgressEvent(type, fromStage, toStage, round, status) {
      let events = reviewEvents(request.resource.data);
      let event = events[events.size() - 1];
      return appendsOneReviewEvent()
        && lastReviewEventMatches(
          type, fromStage, toStage, round, status, managerEventRole()
        )
        && (!(type in ['director_revision_requested', 'client_revision_requested'])
          || (event.get('reason', '') is string
            && event.get('reason', '').size() > 0
            && event.get('reason', '').size() <= 2000));
    }

    // Completion of a dispatch/direct-client job belongs to its assigned
    // editor and is protected by the paired delivery-completion event.  The
    // manager completion path remains for edit-agency jobs only.
    function managerMayCompleteJob() {
      return resource.data.get('businessType', '') != 'dispatch'
        && resource.data.get('source', '') != 'direct_client';
    }

    function hasReviewWorkflow(data) {
      return 'workflow' in data && data.workflow is map;
    }

    function reviewStage(data) {
      return data.get('workflow', {}).get('stage', '');
    }

    function reviewRound(data) {
      return data.get('workflow', {}).get('round', -1);
    }

    // A finalised or payment-authorised case is never silently reopened.
    // A correction after approval must be handled through the invoice revision
    // route, not by changing the operational case back to editing.
    function preservesFinalJob() {
      return !(
        resource.data.status == '完了'
        || resource.data.get('payableApproved', false) == true
      ) || request.resource.data.status == '完了';
    }

    // Editor-owned action: submit the current draft for director review.
    // Old documents without workflow stay on the legacy path below.
    function validEditorReviewTransition(uid, jobId) {
      return (!hasReviewWorkflow(request.resource.data) && reviewEventsUnchanged())
        || (hasReviewWorkflow(request.resource.data)
          &&
          validReviewWorkflow(request.resource.data)
          && validProgressEvents(request.resource.data)
          && ((!hasReviewWorkflow(resource.data)
              && reviewStage(request.resource.data) == 'editing'
              && reviewEventsUnchanged())
            || (!hasReviewWorkflow(resource.data)
              && reviewStage(request.resource.data) == 'director_review'
              && validLegacyEditorSubmissionStatus(
                resource.data.status, request.resource.data.status
              )
              && validEditorSubmittedEvent(
                'editing', reviewRound(request.resource.data), request.resource.data.status
              ))
            || (hasReviewWorkflow(resource.data)
              && reviewStage(request.resource.data) == reviewStage(resource.data)
              && reviewRound(request.resource.data) == reviewRound(resource.data)
              && reviewEventsUnchanged())
            || (hasReviewWorkflow(resource.data)
              && reviewStage(resource.data) == 'editing'
              && reviewStage(request.resource.data) == 'director_review'
              && reviewRound(request.resource.data) == reviewRound(resource.data)
              && validEditorSubmissionStatus(
                resource.data.status, request.resource.data.status
              )
              && validEditorSubmittedEvent(
                'editing', reviewRound(request.resource.data), request.resource.data.status
              ))
            // Delivery completion is the most expensive branch because it
            // verifies the paired immutable event with getAfter(). Keep it
            // last so ordinary progress, date, and submission saves do not
            // spend the request expression budget evaluating it.
            || validEditorDeliveryCompletion(uid, jobId)
          )
        );
    }

    // The paired event and evidence are fully verified once by
    // validEditorReviewTransition(). This ownership check validates only the
    // workflow shape, avoiding the same expensive getAfter() contract twice.
    function validEditorDeliveryWorkflowStatus() {
      return hasReviewWorkflow(resource.data)
        && hasReviewWorkflow(request.resource.data)
        && reviewStage(resource.data) == 'client_review'
        && reviewStage(request.resource.data) == 'delivered'
        && reviewRound(request.resource.data) == reviewRound(resource.data)
        && request.resource.data.status == '完了';
    }

    // Once a workflow exists, only the editor's own submission may change a
    // review status. A saved D/client/final status is manager-owned even when
    // the editor is merely saving dates or a progress memo.
    function validEditorWorkflowStatus() {
      return (!hasReviewWorkflow(resource.data)
          && !hasReviewWorkflow(request.resource.data)
          && (request.resource.data.status == resource.data.status
            || validEditorStartTransition(
              resource.data.status, request.resource.data.status
            )))
        || (!hasReviewWorkflow(resource.data)
          && hasReviewWorkflow(request.resource.data)
          && reviewStage(request.resource.data) == 'editing'
          && (request.resource.data.status == resource.data.status
            || validEditorStartTransition(
              resource.data.status, request.resource.data.status
            )))
        || (!hasReviewWorkflow(resource.data)
          && hasReviewWorkflow(request.resource.data)
          && reviewStage(request.resource.data) == 'director_review'
          && validLegacyEditorSubmissionStatus(
            resource.data.status, request.resource.data.status
          ))
        || (hasReviewWorkflow(resource.data)
          && hasReviewWorkflow(request.resource.data)
          &&
          reviewStage(resource.data) == 'editing'
          && reviewStage(request.resource.data) == 'editing'
          && reviewRound(request.resource.data) == reviewRound(resource.data)
          && (request.resource.data.status == resource.data.status
            || validEditorStartTransition(
              resource.data.status, request.resource.data.status
            ))
        )
        || (hasReviewWorkflow(resource.data)
          && hasReviewWorkflow(request.resource.data)
          &&
          reviewStage(resource.data) == 'editing'
          && reviewStage(request.resource.data) == 'director_review'
          && reviewRound(request.resource.data) == reviewRound(resource.data)
          && validEditorSubmissionStatus(
            resource.data.status, request.resource.data.status
          )
        )
        || (hasReviewWorkflow(resource.data)
          && hasReviewWorkflow(request.resource.data)
          &&
          reviewStage(request.resource.data) == reviewStage(resource.data)
          && reviewRound(request.resource.data) == reviewRound(resource.data)
          && request.resource.data.status == resource.data.status
        )
        || validEditorDeliveryWorkflowStatus();
    }

    // Keep current-workflow and legacy migrations in separate branches. Apart
    // from making the contract easier to audit, this prevents a valid manager
    // action from evaluating every legacy alternative and exceeding the Rules
    // engine's per-request expression limit.
    function validCurrentManagerReviewTransition() {
      return hasReviewWorkflow(resource.data)
        && hasReviewWorkflow(request.resource.data)
        && validReviewWorkflow(request.resource.data)
        && validProgressEvents(request.resource.data)
        && (
          (reviewStage(resource.data) == 'director_review'
            && ((reviewStage(request.resource.data) == 'client_submission'
                && reviewRound(request.resource.data) == reviewRound(resource.data)
                && request.resource.data.status == 'D確認OK'
                && validManagerProgressEvent(
                  'director_approved', 'director_review', 'client_submission',
                  reviewRound(request.resource.data), 'D確認OK'
                ))
              || (reviewStage(request.resource.data) == 'editing'
                && reviewRound(request.resource.data) == reviewRound(resource.data) + 1
                && request.resource.data.status == '修正中'
                && validManagerProgressEvent(
                  'director_revision_requested', 'director_review', 'editing',
                  reviewRound(request.resource.data), '修正中'
                ))))
          || (reviewStage(resource.data) == 'client_review'
            && ((reviewStage(request.resource.data) == 'delivered'
                && managerMayCompleteJob()
                && reviewRound(request.resource.data) == reviewRound(resource.data)
                && request.resource.data.status == '完了'
                && request.resource.data.get('completedDeliveryDate', '') is string
                && request.resource.data.get('completedDeliveryDate', '') != ''
                && validManagerProgressEvent(
                  'client_approved_completed', 'client_review', 'delivered',
                  reviewRound(request.resource.data), '完了'
                ))
              || (reviewStage(request.resource.data) == 'editing'
                && reviewRound(request.resource.data) == reviewRound(resource.data) + 1
                && request.resource.data.status == '修正中'
                && validManagerProgressEvent(
                  'client_revision_requested', 'client_review', 'editing',
                  reviewRound(request.resource.data), '修正中'
                ))))
          || (reviewStage(resource.data) == 'client_submission'
            && reviewStage(request.resource.data) == 'client_review'
            && reviewRound(request.resource.data) == reviewRound(resource.data)
            && request.resource.data.status == '先方確認中'
            && validManagerProgressEvent(
              'client_submitted', 'client_submission', 'client_review',
              reviewRound(request.resource.data), '先方確認中'
            ))
          || (reviewStage(request.resource.data) == reviewStage(resource.data)
            && reviewRound(request.resource.data) == reviewRound(resource.data)
            && request.resource.data.status == resource.data.status
            && validJobStatus(request.resource.data.status)
            && reviewEventsUnchanged())
        );
    }

    function validLegacyManagerReviewTransition() {
      return !hasReviewWorkflow(resource.data)
        && (validLegacyManagerNonWorkflowUpdate()
          || (hasReviewWorkflow(request.resource.data)
            && validReviewWorkflow(request.resource.data)
            && validProgressEvents(request.resource.data)
            && (
              // FB待ちは、旧画面でD確認待ちとして保存された状態です。
              // UIと同じく、最初のD判断でだけworkflow付きの正式状態へ移行します。
              (resource.data.status in ['初稿提出済み', '修正稿提出済み', 'FB待ち']
                && reviewStage(request.resource.data) == 'client_submission'
                && request.resource.data.status == 'D確認OK'
                && validManagerProgressEvent(
                  'director_approved', 'director_review', 'client_submission',
                  reviewRound(request.resource.data), 'D確認OK'
                ))
              || (resource.data.status in ['初稿提出済み', '修正稿提出済み', 'FB待ち']
                && reviewStage(request.resource.data) == 'editing'
                && reviewRound(request.resource.data) == 2
                && request.resource.data.status == '修正中'
                && validManagerProgressEvent(
                  'director_revision_requested', 'director_review', 'editing',
                  reviewRound(request.resource.data), '修正中'
                ))
              || (resource.data.status == 'D確認OK'
                && reviewStage(request.resource.data) == 'client_review'
                && reviewRound(request.resource.data) == 1
                && request.resource.data.status == '先方確認中'
                && validManagerProgressEvent(
                  'client_submitted', 'client_submission', 'client_review',
                  reviewRound(request.resource.data), '先方確認中'
                ))
              || (resource.data.status in ['先方確認中', '確認待ち']
                && reviewStage(request.resource.data) == 'editing'
                && reviewRound(request.resource.data) == 2
                && request.resource.data.status == '修正中'
                && validManagerProgressEvent(
                  'client_revision_requested', 'client_review', 'editing',
                  reviewRound(request.resource.data), '修正中'
                ))
              || (resource.data.status in ['先方確認中', '確認待ち']
                && managerMayCompleteJob()
                && reviewStage(request.resource.data) == 'delivered'
                && reviewRound(request.resource.data) == 1
                && request.resource.data.status == '完了'
                && request.resource.data.get('completedDeliveryDate', '') is string
                && request.resource.data.get('completedDeliveryDate', '') != ''
                && validManagerProgressEvent(
                  'client_approved_completed', 'client_review', 'delivered',
                  reviewRound(request.resource.data), '完了'
                ))
            ))
        );
    }

    // Director/owner actions: approve a submitted draft, record actual client
    // submission, receive a client correction, or finish after client approval.
    function validManagerReviewTransition() {
      return validManagerStatusOverride()
        || validCurrentManagerReviewTransition()
        || validLegacyManagerReviewTransition();
    }

    function validInvoiceStatus(status) {
      return status in [
        '下書き','提出済み','再提出','差戻し','承認済み',
        '支払処理中','支払済み','取消'
      ];
    }

    function validOwnerInvoiceTransition(from, to) {
      return from == to
        || (from in ['提出済み','再提出'] && to in ['差戻し','承認済み','取消'])
        || (from == '差戻し' && to == '取消')
        || (from == '承認済み' && to in ['支払処理中','取消'])
        || (from == '支払処理中' && to == '支払済み');
    }

    // DM peer directory. Editors may discover the owners, and an external
    // editor may discover only the director assigned in their own access row.
    function dmDirectoryVideoMember(uid) {
      return approved(uid)
        && get(accessPath(uid)).data.roles.hasAny(['動画編集者','動画編集ディレクター']);
    }

    function dmDirectoryOwner(uid) {
      return exists(accessPath(uid))
        && get(accessPath(uid)).data.get('email', '') in [
          'nakamurakouta512@gmail.com', 'mono.create.group@gmail.com'
        ];
    }

    function dmDirectoryPeer(uid) {
      return signedIn() && dmDirectoryVideoMember(request.auth.uid)
        && (dmDirectoryOwner(uid)
          || (get(accessPath(request.auth.uid)).data.get('editorKind', 'direct') == 'external'
            && get(accessPath(request.auth.uid)).data.get('directorUid', '') == uid
            && dmDirectoryVideoMember(uid)
            && get(accessPath(uid)).data.roles.hasAny(['動画編集ディレクター'])));
    }

    match /access/{uid} {
      allow read: if owner() || self(uid) || dmDirectoryPeer(uid) || (videoManager()
        && resource.data.get('directorUid', '') == request.auth.uid);
      allow create: if owner();
      allow update: if owner() || (self(uid)
        && resource.data.approved == true
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.name.size() <= 80
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'name','updatedAt'
        ]));
      allow delete: if false;
    }

    match /system/access_control {
      allow read: if owner()
        || (signedIn() && !pureEditor(request.auth.uid)
          && (approved(request.auth.uid) || compatibilityAllowed()));
      allow create, update: if owner()
        && request.resource.data.enforced is bool;
      allow delete: if false;
    }

    match /system/releases_current {
      allow read: if owner() || approvedMember() || coreStaff();
      allow create, update: if owner();
      allow delete: if false;
    }

    match /accessRequests/{uid} {
      allow create: if self(uid)
        && request.resource.data.keys().hasOnly([
          'uid','email','name','photo','status','lastRequestedAt'
        ])
        && request.resource.data.uid == uid
        && request.resource.data.email == request.auth.token.email
        && request.resource.data.status == 'pending';
      allow update: if owner() || (self(uid)
        && request.resource.data.uid == resource.data.uid
        && request.resource.data.email == resource.data.email
        && request.resource.data.status == 'pending'
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'name','photo','status','lastRequestedAt'
        ]));
      allow read: if owner() || self(uid);
      allow delete: if false;
    }

    // Private 1:1 conversations.  These records intentionally contain no
    // client, job, payout or invoice fields.  An owner can talk with every
    // approved video editor/director; a director can additionally talk with
    // only the external editors assigned to that director.
    function dmVideoMember(uid) {
      return approved(uid)
        && get(accessPath(uid)).data.roles.hasAny(['動画編集者','動画編集ディレクター']);
    }

    function dmOwnerUid(uid) {
      return exists(accessPath(uid))
        && get(accessPath(uid)).data.get('email', '') in [
          'nakamurakouta512@gmail.com', 'mono.create.group@gmail.com'
        ];
    }

    function dmExternalFor(externalUid, directorUid) {
      return dmVideoMember(externalUid)
        && dmVideoMember(directorUid)
        && get(accessPath(externalUid)).data.get('editorKind', 'direct') == 'external'
        && get(accessPath(externalUid)).data.get('directorUid', '') == directorUid
        && get(accessPath(directorUid)).data.roles.hasAny(['動画編集ディレクター']);
    }

    function dmAllowedPair(a, b, ownerUid) {
      return (ownerUid == a && dmOwnerUid(a) && dmVideoMember(b))
        || (ownerUid == b && dmOwnerUid(b) && dmVideoMember(a))
        || (ownerUid == '' && (dmExternalFor(a, b) || dmExternalFor(b, a)));
    }

    function validDmThread(data) {
      return data.keys().hasOnly([
          'participantA','participantB','participants','ownerUid','createdAt','updatedAt',
          'lastMessageAt','lastMessagePreview','lastSenderUid','lastSenderName'
        ])
        && data.participantA is string && data.participantB is string
        && data.participantA.size() > 0 && data.participantB.size() > 0
        && data.participantA < data.participantB
        && data.participants is list && data.participants.size() == 2
        && data.participants[0] == data.participantA && data.participants[1] == data.participantB
        && data.ownerUid is string
        && (data.ownerUid == '' || data.ownerUid == data.participantA || data.ownerUid == data.participantB)
        && data.lastMessagePreview is string && data.lastMessagePreview.size() <= 120
        && data.lastSenderUid is string && data.lastSenderUid.size() <= 128
        && data.lastSenderName is string && data.lastSenderName.size() <= 100;
    }

    function dmParticipant(data) {
      // A director/external conversation is live only while the current
      // access-directory relationship still matches.  This closes historic
      // threads immediately when an external editor moves to another director.
      // Owner conversations remain available because their owner identity was
      // validated on creation and is immutable afterwards.
      let participants = data.get('participants', []);
      let participantA = data.get('participantA', '');
      let participantB = data.get('participantB', '');
      let ownerUid = data.get('ownerUid', '');
      return signedIn()
        && request.auth.uid in participants
        && (ownerUid != ''
          || dmAllowedPair(participantA, participantB, ''));
    }

    // List queries are intentionally narrower than single-thread reads.
    // Current director/external conversations require a relationship lookup,
    // which Firestore cannot prove from an array-contains query.  The client
    // opens those deterministic IDs individually.  Only owner conversations
    // are listable, with a query that explicitly includes ownerUid.
    function dmListableOwnerConversation(data) {
      return signedIn()
        && request.auth.uid in data.get('participants', [])
        && data.get('ownerUid', '') != ''
        && (owner()
          ? data.get('ownerUid', '') == request.auth.uid
          : dmVideoMember(request.auth.uid));
    }

    match /direct_threads/{threadId} {
      allow get: if dmParticipant(resource.data);
      allow list: if dmListableOwnerConversation(resource.data);
      // Creation already validates the complete relationship below. Calling
      // dmParticipant() here repeated the same access-directory walk and could
      // exhaust the expression budget for an invalid pair.
      allow create: if signedIn()
        && request.auth.uid in request.resource.data.get('participants', [])
        && validDmThread(request.resource.data)
        && (
          // The owner may bootstrap an owner/editor conversation even before
          // the owner has an access-directory document.
          (owner() && request.resource.data.ownerUid == request.auth.uid
            && ((request.resource.data.participantA == request.auth.uid
                && dmVideoMember(request.resource.data.participantB))
              || (request.resource.data.participantB == request.auth.uid
                && dmVideoMember(request.resource.data.participantA))))
          || dmAllowedPair(
            request.resource.data.participantA,
            request.resource.data.participantB,
            request.resource.data.ownerUid
          )
        );
      // Participants can only touch the current-message summary.  The pair,
      // owner relation and creation time never change after creation.
      allow update: if dmParticipant(resource.data)
        && validDmThread(request.resource.data)
        && request.resource.data.participantA == resource.data.participantA
        && request.resource.data.participantB == resource.data.participantB
        && request.resource.data.participants == resource.data.participants
        && request.resource.data.ownerUid == resource.data.ownerUid
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'updatedAt','lastMessageAt','lastMessagePreview','lastSenderUid','lastSenderName'
        ])
        && request.resource.data.lastSenderUid == request.auth.uid;
      allow delete: if false;

      match /messages/{messageId} {
        allow read: if dmParticipant(get(/databases/$(database)/documents/direct_threads/$(threadId)).data);
        allow create: if dmParticipant(get(/databases/$(database)/documents/direct_threads/$(threadId)).data)
          && request.resource.data.keys().hasOnly(['senderUid','senderName','body','createdAt'])
          && request.resource.data.senderUid == request.auth.uid
          && request.resource.data.senderName is string
          && request.resource.data.senderName.size() > 0
          && request.resource.data.senderName.size() <= 100
          && request.resource.data.body is string
          && request.resource.data.body.size() > 0
          && request.resource.data.body.size() <= 2000;
        allow update, delete: if false;
      }

      // A read receipt is private to its owner.  It cannot alter messages or
      // another participant's unread state.
      match /reads/{uid} {
        allow read: if self(uid)
          && dmParticipant(get(/databases/$(database)/documents/direct_threads/$(threadId)).data);
        allow create, update: if self(uid)
          && dmParticipant(get(/databases/$(database)/documents/direct_threads/$(threadId)).data)
          && request.resource.data.keys().hasOnly(['readerUid','lastReadAt','updatedAt'])
          && request.resource.data.readerUid == uid;
        allow delete: if false;
      }
    }

    // Existing monolith data. A video editor is denied even when another role was
    // accidentally added; the app also prevents that combination at assignment time.
    // Directors use scoped portal data instead of this company-wide record.
    match /shared/{document=**} {
      allow read: if owner() || legacyMonolithStaff();
      allow create, delete: if owner() || legacyMonolithStaff();
      allow update: if (owner() || legacyMonolithStaff())
        // Only shared/mcapp receives ownerLegacyFinanceMigrationAt. Shards
        // have no marker, so this remains a no-op for mcapp_leads_* etc.
        && migratedLegacyJobsWriteAllowed();
    }

    match /users/{uid} {
      // The dedicated editor portal does not use this legacy personal document.
      // Denying editors and video directors also prevents historical local-state
      // copies of the company-wide record from leaking.
      allow read, write: if owner() || (self(uid) && legacyMonolithStaff());
    }

    // Client billing prices and per-account overrides are never copied into
    // editor-readable catalog or portal documents.
    match /owner_client_pricing/{pricingId} {
      allow read: if owner();
      allow create, update: if owner() && validOwnerClientPricingDocument();
      allow delete: if owner();
    }

    match /owner_client_rates/{rateId} {
      allow read: if owner();
      allow create: if owner() && validOwnerClientRateDocument();
      allow update: if owner() && validOwnerClientRateUpdate();
      allow delete: if false;
    }

    // Confirmed per-case revenue and payment routing.  It is never copied to
    // the company-wide legacy record or an editor-readable portal document.
    match /owner_job_finance/{financeId} {
      allow read: if owner();
      allow create: if owner() && validOwnerJobFinanceDocument();
      allow update: if owner() && validOwnerJobFinanceUpdate();
      allow delete: if false;
    }

    // Owner-only monthly targets and immutable daily acknowledgement records.
    // Editors never write a number merely to unlock their own portal.
    match /owner_delivery_goals/{month} {
      allow read: if owner();
      allow create: if owner() && validOwnerDeliveryGoal() && request.resource.data.month == month;
      allow update: if owner() && validOwnerDeliveryGoalUpdate() && request.resource.data.month == month;
      allow delete: if false;
    }

    match /owner_daily_delivery_checks/{date} {
      allow read: if owner();
      allow create: if owner() && validOwnerDailyDeliveryCheck() && request.resource.data.date == date;
      allow update, delete: if false;
    }

    match /owner_editor_quality_reviews/{reviewId} {
      allow read: if owner();
      allow create: if owner() && validOwnerQualityReview();
      allow update: if owner() && validOwnerQualityReviewUpdate();
      allow delete: if false;
    }

    match /editor_weekly_rankings/{weekStart} {
      allow read: if owner() || (approvedMember()
        && (hasRole(request.auth.uid, '動画編集者') || hasRole(request.auth.uid, '動画編集ディレクター')));
      allow create: if owner() && validEditorWeeklyRanking() && request.resource.data.weekStart == weekStart;
      allow update: if owner() && validEditorWeeklyRanking()
        && request.resource.data.weekStart == resource.data.weekStart
        && request.resource.data.revision == resource.data.revision + 1;
      allow delete: if false;
    }

    // Migration-only immutable copies of legacy financial rows. These remain
    // owner-only even after directors are allowed to manage scoped operations.
    match /owner_legacy_finance/{financeId} {
      allow read: if owner();
      allow create: if owner() && validOwnerLegacyFinanceDocument(financeId);
      allow update: if owner() && validOwnerLegacyFinanceUpdate(financeId);
      allow delete: if false;
    }

    match /owner_legacy_finance_corrections/{correctionId} {
      allow read: if owner();
      allow create: if owner() && validOwnerLegacyFinanceCorrectionDocument(correctionId);
      allow update, delete: if false;
    }

    // 編集者が初稿・修正稿の保存に失敗した記録。編集者本人だけが作成でき、
    // オーナーが「提出確認」で原因を確認する。本文・金額は含めない。
    match /editor_submit_failures/{failureId} {
      allow read: if owner() || (signedIn() && resource.data.uid == request.auth.uid);
      allow create: if signedIn()
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.keys().hasOnly([
          'uid','email','editorName','jobId','jobTitle','parentCaseName','status','previousStatus',
          'editorSubmitted','code','message','appVersion','workflow','sharedDate','editorDraftDate',
          'clientDraftDate','deliveryDate','hasEvidence','evidenceOk','userAgent','at','clientAt'
        ])
        && request.resource.data.jobId is string && request.resource.data.jobId.size() <= 160
        && request.resource.data.jobTitle is string && request.resource.data.jobTitle.size() <= 120
        && request.resource.data.status is string && request.resource.data.status.size() <= 40
        && request.resource.data.code is string && request.resource.data.code.size() <= 60
        && request.resource.data.message is string && request.resource.data.message.size() <= 300
        && request.resource.data.userAgent is string && request.resource.data.userAgent.size() <= 200
        && request.resource.data.at == request.time;
      allow update, delete: if false;
    }

    match /editor_portals/{uid} {
      allow read: if portalManager(uid) || editor(uid);
      allow create, update: if owner();
      allow delete: if false;

      // A correction learning record belongs to the portal editor.  Only the
      // owner or that editor's assigned director can review it, and the
      // original text/job scope remain immutable after submission.
      match /feedback/{feedbackId} {
        allow read: if portalManager(uid) || self(uid);
        allow create: if validFeedbackCreate(uid);
        allow update: if validFeedbackReview(uid)
          && request.resource.data.recordType == resource.data.recordType
          && request.resource.data.portalUid == resource.data.portalUid
          && request.resource.data.jobId == resource.data.jobId
          && request.resource.data.parentCaseId == resource.data.parentCaseId
          && request.resource.data.editorUid == resource.data.editorUid
          && request.resource.data.editorName == resource.data.editorName
          && request.resource.data.jobTitle == resource.data.jobTitle
          && request.resource.data.clientId == resource.data.clientId
          && request.resource.data.accountId == resource.data.accountId
          && request.resource.data.clientName == resource.data.clientName
          && request.resource.data.accountName == resource.data.accountName
          && request.resource.data.correctionReason == resource.data.correctionReason
          && request.resource.data.learning == resource.data.learning
          && request.resource.data.createdAt == resource.data.createdAt;
        allow delete: if false;
      }

      match /editor_jobs/{jobId} {
        allow read: if owner()
          || (directorFor(uid) && !containsExternalSettlement(resource.data))
          || (editor(uid)
            && (!externalEditor(uid) || !containsExternalSettlement(resource.data)));
        // For a board claim, reject a stale/already-assigned board before the
        // large portal schema validation. This keeps a losing transaction from
        // exhausting the shared batch expression budget.
        allow create: if request.resource.data.get('source', '') == 'legacy_sync'
          ? validOwnerLegacyPortalJobCreate(uid)
          : (request.resource.data.get('source', '') in ['direct_client','job_board']
          && (request.resource.data.get('source', '') != 'job_board'
            || (request.resource.data.get('boardJobId', '') is string
              && request.resource.data.boardJobId == jobId
              && validClaimedBoardProjection(jobId)))
          && editor(uid)
          && request.resource.data.keys().hasOnly([
            'recordType','businessType','boardJobId','title','caseName','parentCaseId','parentCaseName',
            'clientId','sourceClientId','clientDisplay','accountId','accountDisplay','deadline','requestUrl','sourceUrl',
            'sharedDate','editorDraftDate','editorDraftDateSetter','clientDraftDate','thumbnailDate','deliveryDate',
            'instructions','urgent','status','progress','evidenceUrl','blocker',
            'workDate','startTime','endTime','submittedByUid','editorUid',
            'editorEmail','editorName','directorUid','source','createdAt','updatedAt','history',
            'workflow','progressEvents','parentJobId','parentJobTitle','attachments','editorPayAmount','subtaskIndex',
            'manualIds','parentManualIds','caution','parentCaution'
          ])
          && request.resource.data.recordType == 'editor_portal_job'
          && request.resource.data.submittedByUid == uid
          && request.resource.data.editorUid == uid
          && request.resource.data.editorEmail == request.auth.token.email
          && request.resource.data.get('businessType', '') in ['dispatch','edit_agency']
          && request.resource.data.title is string
          && request.resource.data.title.size() > 0
          && request.resource.data.title.size() <= 120
          && request.resource.data.get('parentCaseId', '') is string
          && request.resource.data.get('parentCaseId', '').size() <= 160
          && request.resource.data.get('parentCaseName', '') is string
          && request.resource.data.get('parentCaseName', '').size() <= 120
          && request.resource.data.get('sourceClientId', '') is string
          && request.resource.data.get('sourceClientId', '').size() <= 160
          && (request.resource.data.get('source', '') != 'direct_client'
            || request.resource.data.get('sourceClientId', '').size() > 0)
          && request.resource.data.clientDisplay is string
          && request.resource.data.clientDisplay.size() > 0
          && request.resource.data.instructions is string
          && request.resource.data.instructions.size() <= 3000
          && request.resource.data.status == 'アサイン済み'
          && validJobSchedule()
          && validEditorPayAmountForCreate()
          && validEditorDraftDateAssignment(request.resource.data)
          && validCaseManualLinks(request.resource.data)
          && validCompletedJobEvidence()
          && validReviewWorkflow(request.resource.data)
          && validProgressEvents(request.resource.data)
          && validAttachments(request.resource.data)
          && validSubtaskIndex(request.resource.data)
          && request.resource.data.history is list
          && request.resource.data.history.size() == 1);
        // Exactly one update intent is evaluated. This is both stricter and
        // measurably cheaper than independent overlapping `allow update` rules.
        allow update: if resource != null && validPortalJobUpdate(uid, jobId);
        // Legacy-synchronised portal rows are recoverable projections of the
        // owner ledger. On reassignment, the owner atomically creates the new
        // assignee projection and removes only the former one.
        allow delete: if owner()
          && resource.data.get('source', '') == 'legacy_sync';

        match /events/{eventId} {
          // A Firestore parent delete does not cascade into subcollections.
          // Requiring the current parent prevents a former assignee from
          // reading or appending to orphaned history after reassignment.
          allow read: if exists(/databases/$(database)/documents/editor_portals/$(uid)/editor_jobs/$(jobId))
            && (portalManager(uid) || editor(uid));
          allow create: if existsAfter(/databases/$(database)/documents/editor_portals/$(uid)/editor_jobs/$(jobId))
            && (portalManager(uid)
            || (editor(uid) && request.resource.data.byUid == uid
              && (request.resource.data.get('type', '') != 'editor_delivery_completed'
                || (request.resource.data.keys().hasOnly([
                      'at','type','byUid','byEmail','byRole','status','fromStage','toStage','round',
                      'completedDeliveryDate','evidenceUrl'
                    ])
                    && eventId == 'delivery-completion'
                    && request.resource.data.at is timestamp
                    && request.resource.data.byUid is string
                    && request.resource.data.byEmail is string
                    && request.resource.data.byEmail.size() <= 320
                    && request.resource.data.byRole == '担当編集者'
                    && request.resource.data.status == '完了'
                    && request.resource.data.fromStage == 'client_review'
                    && request.resource.data.toStage == 'delivered'
                    && request.resource.data.round is int
                    && request.resource.data.round >= 1
                    && request.resource.data.completedDeliveryDate is string
                    && request.resource.data.completedDeliveryDate.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
                    && request.resource.data.evidenceUrl is string
                    && request.resource.data.evidenceUrl.matches('^https?://.+')
                    && (getAfter(/databases/$(database)/documents/editor_portals/$(uid)/editor_jobs/$(jobId)).data.get('businessType', '') == 'dispatch'
                      || getAfter(/databases/$(database)/documents/editor_portals/$(uid)/editor_jobs/$(jobId)).data.get('source', '') == 'direct_client')
                    && getAfter(/databases/$(database)/documents/editor_portals/$(uid)/editor_jobs/$(jobId)).data.status == '完了'
                    && getAfter(/databases/$(database)/documents/editor_portals/$(uid)/editor_jobs/$(jobId)).data.workflow.stage == 'delivered'
                    && getAfter(/databases/$(database)/documents/editor_portals/$(uid)/editor_jobs/$(jobId)).data.workflow.round == request.resource.data.round
                    && getAfter(/databases/$(database)/documents/editor_portals/$(uid)/editor_jobs/$(jobId)).data.get('completedDeliveryDate', '') == request.resource.data.completedDeliveryDate
                    && getAfter(/databases/$(database)/documents/editor_portals/$(uid)/editor_jobs/$(jobId)).data.get('evidenceUrl', '') == request.resource.data.evidenceUrl
                    && getAfter(/databases/$(database)/documents/editor_portals/$(uid)/editor_jobs/$(jobId)).data.get('blocker', '') == ''))));
          allow update, delete: if false;
        }

        match /messages/{messageId} {
          allow read: if exists(/databases/$(database)/documents/editor_portals/$(uid)/editor_jobs/$(jobId))
            && (portalManager(uid) || editor(uid));
          allow create: if existsAfter(/databases/$(database)/documents/editor_portals/$(uid)/editor_jobs/$(jobId))
            && (portalManager(uid)
              || (editor(uid) && request.resource.data.byUid == uid))
            && request.resource.data.keys().hasOnly([
              'body','kind','url','byUid','byName','byRole','createdAt'
            ])
            && request.resource.data.body is string
            && request.resource.data.body.size() > 0
            && request.resource.data.body.size() <= 2000
            && request.resource.data.kind in [
              '質問','回答','初稿提出','修正指示',
              '修正稿提出','納品','連絡'
            ]
            && request.resource.data.url is string
            && (request.resource.data.url == ''
              || request.resource.data.url.matches('^https?://.+'));
          allow update, delete: if false;
        }
      }

      match /invoice_authorizations/{authorizationId} {
        allow read: if owner() || (editor(uid) && !externalEditor(uid));
        allow create, update: if owner()
          && request.resource.data.recordType == 'invoice_authorization'
          && request.resource.data.taxInclusive == true
          && request.resource.data.editorUid == uid
          && request.resource.data.month is string
          && request.resource.data.invoiceAvailableOn is string
          && request.resource.data.invoiceAvailableOn.matches('^[0-9]{4}-[0-9]{2}-25$')
          && request.resource.data.paymentDueDate is string
          && request.resource.data.paymentDueDate.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
          && request.resource.data.jobIds is list
          && request.resource.data.lines is list
          && request.resource.data.jobIds.size() == request.resource.data.lines.size()
          && request.resource.data.subtotal >= 0
          && request.resource.data.tax >= 0
          && request.resource.data.total == request.resource.data.subtotal + request.resource.data.tax
          && request.resource.data.revision is int
          && request.resource.data.revision >= 1
          && request.resource.data.invoiceVersion is int
          && request.resource.data.invoiceVersion >= 1
          && request.resource.data.invoiceDocumentId is string;
        allow delete: if false;

        match /events/{eventId} {
          allow read: if owner() || (editor(uid) && !externalEditor(uid));
          allow create: if owner();
          allow update, delete: if false;
        }
      }

      match /editor_invoices/{invoiceId} {
        allow read: if owner() || (editor(uid) && !externalEditor(uid));
        allow create: if editor(uid) && !externalEditor(uid)
          && request.resource.data.keys().hasOnly([
            'recordType','taxInclusive','editorUid','editorEmail','editorName','month','jobIds',
            'lines','issuer','recipientName','documentType','subtotal','taxByRate',
            'tax','withholding','withholdingStatus','total','status','invoiceNumber',
            'issueDate','dueDate','invoiceAvailableOn','paymentDueDate',
            'retentionUntil','version','idempotencyKey','file',
            'ownerShareStatus','createdAt','updatedAt','history',
            'submittedAt','reviewReason','supersedesInvoiceId',
            'authorizationId','authorizationRevision','note'
          ])
          && request.resource.data.get('note', '') is string
          && request.resource.data.get('note', '').size() <= 500
          && request.resource.data.recordType == 'editor_invoice'
          && request.resource.data.taxInclusive == true
          && request.resource.data.editorUid == uid
          && request.resource.data.editorEmail == request.auth.token.email
          && request.resource.data.status == '下書き'
          && request.resource.data.authorizationId is string
          && request.resource.data.authorizationRevision is int
          && (validInvoiceAuthorization(uid, invoiceId) || validManualInvoice(uid))
          && request.resource.data.jobIds is list
          && request.resource.data.jobIds.size() > 0
          && request.resource.data.jobIds.size() <= 100
          && request.resource.data.lines is list
          && request.resource.data.lines.size() == request.resource.data.jobIds.size()
          && request.resource.data.version is int
          && request.resource.data.version >= 1
          && request.resource.data.retentionUntil is string
          && request.resource.data.subtotal >= 0
          && request.resource.data.tax >= 0
          && request.resource.data.total == request.resource.data.subtotal + request.resource.data.tax;
        allow update: if editor(uid) && !externalEditor(uid)
          && resource.data.status == '下書き'
          && (validInvoiceAuthorization(uid, invoiceId) || validManualInvoice(uid))
          && validInvoiceStatus(request.resource.data.status)
          && request.resource.data.status in ['下書き','提出済み']
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'file','ownerShareStatus','status','submittedAt','updatedAt',
            'recipientName','issuer','taxInclusive','jobIds','lines','subtotal','taxByRate','tax','total','note'
          ])
          && request.resource.data.get('note', '') is string
          && request.resource.data.get('note', '').size() <= 500
          && (request.resource.data.status == '下書き'
            || (request.resource.data.file.provider == 'google-drive'
              && request.resource.data.file.id is string
              && request.resource.data.file.sha256 is string
              && request.resource.data.ownerShareStatus == 'shared'));
        allow update: if owner()
          && validInvoiceStatus(request.resource.data.status)
          && (request.resource.data.status != '承認済み'
            || request.resource.data.get('taxInclusive', false) == true)
          && validOwnerInvoiceTransition(resource.data.status, request.resource.data.status)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'status','reviewReason','updatedAt','updatedBy','history',
            'withholding','withholdingStatus','paymentScheduledAt','paidAt'
          ]);
        allow delete: if false;

        match /events/{eventId} {
          allow read: if owner() || (editor(uid) && !externalEditor(uid));
          allow create: if owner()
            || (editor(uid) && !externalEditor(uid) && request.resource.data.byUid == uid);
          allow update, delete: if false;
        }
      }

      match /submissions/{submissionId} {
        allow read: if portalManager(uid) || editor(uid);
        // No shipped write path uses this legacy collection.  Its former
        // free-form write permission made arbitrary, unauditable submission
        // records look authoritative beside workflow events, so fail closed.
        allow create: if false;
        allow update, delete: if false;
      }

      match /editor_profile/{documentId} {
        allow read: if portalManager(uid) || editor(uid);
        allow create: if owner() || (editor(uid)
          && request.resource.data.keys().hasOnly([
            'issuerName','address','registrationNumber','registrationVerified','taxRate',
            'bankName','bankBranch','bankType','bankNumber','bankHolder','updatedAt'
          ])
          && validIssuerAddress()
          && request.resource.data.registrationVerified == false);
        allow update: if owner() || (editor(uid)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'issuerName','address','registrationNumber','registrationVerified','taxRate',
            'bankName','bankBranch','bankType','bankNumber','bankHolder','updatedAt'
          ])
          && validIssuerAddress()
          && (request.resource.data.registrationVerified == false
            || request.resource.data.registrationVerified == resource.data.registrationVerified));
        allow delete: if false;
      }

      match /client_catalog/{clientId} {
        allow read: if portalManager(uid) || editor(uid);
        allow create, update: if catalogManager(uid)
          && validClientCatalogDocument();
        allow delete: if false;
      }

      match /manual_reads/{manualId} {
        allow read: if portalManager(uid) || editor(uid);
        allow create, update: if editor(uid)
          && request.resource.data.keys().hasOnly(['manualId','version','readAt'])
          && request.resource.data.manualId == manualId
          && request.resource.data.version is string;
        allow delete: if false;
      }

      // One installed device owns one immutable document ID.  Each eligible
      // account (owner, director, or editor) can only see and replace its own
      // subscription.  Endpoint and encryption material are never visible to
      // a manager acting on somebody else's portal.
      // The subscription endpoint is sensitive and must never be listed to
      // other editors or exposed in any shared case/DM document.
      match /push_devices/{deviceId} {
        allow read: if pushDeviceOwner(uid);
        allow create: if pushDeviceOwner(uid)
          && request.resource.data.keys().hasOnly([
            'deviceId','endpoint','keys','permission','appInstalled',
            'appPath','platform','userAgent','schemaVersion','createdAt','updatedAt'
          ])
          && request.resource.data.deviceId == deviceId
          && request.resource.data.deviceId is string
          && request.resource.data.deviceId.matches('^[A-Za-z0-9_-]{20,80}$')
          && request.resource.data.endpoint is string
          && request.resource.data.endpoint.matches('^https://.+')
          && request.resource.data.endpoint.size() <= 2000
          && request.resource.data.keys is map
          && request.resource.data.keys.keys().hasOnly(['p256dh','auth'])
          && request.resource.data.keys.p256dh is string
          && request.resource.data.keys.p256dh.size() >= 20
          && request.resource.data.keys.p256dh.size() <= 300
          && request.resource.data.keys.auth is string
          && request.resource.data.keys.auth.size() >= 10
          && request.resource.data.keys.auth.size() <= 300
          && request.resource.data.permission == 'granted'
          && request.resource.data.appInstalled == true
          && request.resource.data.appPath in [
            './?notification=1', './editor.html?notification=1'
          ]
          && request.resource.data.platform is string
          && request.resource.data.platform.size() <= 180
          && request.resource.data.userAgent is string
          && request.resource.data.userAgent.size() <= 400
          && request.resource.data.schemaVersion == 1;
        allow update: if pushDeviceOwner(uid)
          && request.resource.data.deviceId == resource.data.deviceId
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'endpoint','keys','permission','appInstalled','appPath','platform','userAgent','schemaVersion','updatedAt'
          ])
          && request.resource.data.endpoint is string
          && request.resource.data.endpoint.matches('^https://.+')
          && request.resource.data.endpoint.size() <= 2000
          && request.resource.data.keys is map
          && request.resource.data.keys.keys().hasOnly(['p256dh','auth'])
          && request.resource.data.keys.p256dh is string
          && request.resource.data.keys.p256dh.size() >= 20
          && request.resource.data.keys.p256dh.size() <= 300
          && request.resource.data.keys.auth is string
          && request.resource.data.keys.auth.size() >= 10
          && request.resource.data.keys.auth.size() <= 300
          && request.resource.data.permission == 'granted'
          && request.resource.data.appInstalled == true
          && request.resource.data.appPath in [
            './?notification=1', './editor.html?notification=1'
          ]
          && request.resource.data.platform is string
          && request.resource.data.platform.size() <= 180
          && request.resource.data.userAgent is string
          && request.resource.data.userAgent.size() <= 400
          && request.resource.data.schemaVersion == 1;
        allow delete: if pushDeviceOwner(uid);
      }
    }

    match /editor_job_board/{jobId} {
      allow read: if owner() || coreStaff() || canSeeBoard(resource.data)
        || (signedIn() && resource.data.get('assignedUid', '') == request.auth.uid);
      allow create: if videoManager()
        && request.resource.data.keys().hasOnly([
          'businessType','title','caseName','parentCaseId','parentCaseName','clientId','clientName','accountId','accountName',
          'summary','instructions','requestUrl','sourceUrl','attachments','manualIds','parentManualIds','caution','parentCaution','editorDraftDate','editorDraftDateSetter',
          'clientDraftDate','thumbnailDate','deliveryDate','urgent','status',
          'audience','eligibleUids','directorUid','createdByUid','createdByName',
          'createdAt','updatedAt','assignedUid','assignedName','assignedAt','subtaskIndex'
        ])
        && request.resource.data.businessType == 'edit_agency'
        && request.resource.data.title is string
        && request.resource.data.title.size() > 0
        && request.resource.data.title.size() <= 120
        && request.resource.data.get('parentCaseId', '') is string
        && request.resource.data.get('parentCaseId', '').size() <= 160
        && request.resource.data.get('parentCaseName', '') is string
        && request.resource.data.get('parentCaseName', '').size() <= 120
        && request.resource.data.status == 'open'
        && validEditorDraftDateAssignment(request.resource.data)
        && validCaseManualLinks(request.resource.data)
        && validAttachments(request.resource.data)
        && validSubtaskIndex(request.resource.data)
        && request.resource.data.eligibleUids is list
        && request.resource.data.get('assignedUid', '') == ''
        && (owner() || validDirectorBoardAudience(request.resource.data));
      // Owner edits, director edits, and editor claims are mutually exclusive
      // intents. A single dispatcher prevents an invalid director edit from
      // also paying the full cost of the claim rule.
      allow update: if owner()
        ? (validAttachments(request.resource.data)
          && validEditorDraftDateAssignment(request.resource.data)
          && validCaseManualLinks(request.resource.data))
        : (resource.data.status == 'open'
            && resource.data.get('assignedUid', '') == ''
            && request.resource.data.status == 'assigned'
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
              'status','assignedUid','assignedName','assignedAt','updatedAt'
            ]))
          ? (canSeeBoard(resource.data)
            && request.resource.data.assignedUid == request.auth.uid)
          : (videoManager()
            && validDirectorBoardUpdate()
            && validAttachments(request.resource.data)
            && validEditorDraftDateAssignment(request.resource.data)
            && validCaseManualLinks(request.resource.data));
      allow delete: if false;
    }

    match /editor_schedules/{uid} {
      allow read: if videoWorkspaceMember();
      allow create, update: if editor(uid)
        && request.resource.data.keys().hasOnly([
          'name','fromDate','toDate','hoursPerWeek','capacity','workType',
          'available','note','weekStart','weekEnd','days','routineEnabled',
          'routine','updatedAt'
        ])
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.name.size() <= 100
        && request.resource.data.weekStart.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && request.resource.data.weekEnd.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && request.resource.data.weekEnd >= request.resource.data.weekStart
        && request.resource.data.fromDate == request.resource.data.weekStart
        && request.resource.data.toDate == request.resource.data.weekEnd
        && request.resource.data.days is list
        && request.resource.data.days.size() == 7
        && request.resource.data.routineEnabled is bool
        && request.resource.data.routine is list
        && request.resource.data.routine.size() <= 7
        && request.resource.data.toDate >= request.resource.data.fromDate
        && request.resource.data.hoursPerWeek >= 0
        && request.resource.data.hoursPerWeek <= 168
        && request.resource.data.capacity >= 0
        && request.resource.data.capacity <= 140
        && request.resource.data.workType in ['short','long','both']
        && request.resource.data.note is string
        && request.resource.data.note.size() <= 300;
      allow delete: if false;
    }

    function validFeedbackDocument(uid) {
      return request.resource.data.keys().hasOnly([
          'recordType','portalUid','jobId','parentCaseId','editorUid','editorName','jobTitle',
          'clientId','accountId','clientName','accountName','correctionReason','learning','status',
          'reviewNote','reviewedByUid','reviewedByName','manualId','createdAt','updatedAt'
        ])
        && request.resource.data.recordType == 'editor_feedback'
        && request.resource.data.portalUid == uid
        && request.resource.data.editorUid == uid
        && request.resource.data.jobId is string && request.resource.data.jobId.size() > 0 && request.resource.data.jobId.size() <= 220
        && request.resource.data.parentCaseId is string && request.resource.data.parentCaseId.size() <= 160
        && request.resource.data.editorName is string && request.resource.data.editorName.size() <= 120
        && request.resource.data.jobTitle is string && request.resource.data.jobTitle.size() > 0 && request.resource.data.jobTitle.size() <= 160
        && request.resource.data.clientId is string && request.resource.data.clientId.size() <= 160
        && request.resource.data.accountId is string && request.resource.data.accountId.size() <= 160
        && request.resource.data.clientName is string && request.resource.data.clientName.size() <= 120
        && request.resource.data.accountName is string && request.resource.data.accountName.size() <= 120
        && request.resource.data.correctionReason is string && request.resource.data.correctionReason.size() <= 1800
        && request.resource.data.learning is string && request.resource.data.learning.size() > 0 && request.resource.data.learning.size() <= 1800
        && request.resource.data.status in ['submitted','approved','rejected']
        && request.resource.data.reviewNote is string && request.resource.data.reviewNote.size() <= 800
        && request.resource.data.reviewedByUid is string && request.resource.data.reviewedByUid.size() <= 160
        && request.resource.data.reviewedByName is string && request.resource.data.reviewedByName.size() <= 120
        && request.resource.data.manualId is string && request.resource.data.manualId.size() <= 220
        && request.resource.data.createdAt is timestamp && request.resource.data.updatedAt is timestamp;
    }

    function validFeedbackCreate(uid) {
      let jobPath = /databases/$(database)/documents/editor_portals/$(uid)/editor_jobs/$(request.resource.data.jobId);
      return validFeedbackDocument(uid)
        && self(uid)
        && exists(jobPath)
        && get(jobPath).data.editorUid == uid
        && request.resource.data.status == 'submitted'
        && request.resource.data.reviewNote == ''
        && request.resource.data.reviewedByUid == ''
        && request.resource.data.reviewedByName == ''
        && request.resource.data.manualId == '';
    }

    function validFeedbackReview(uid) {
      return validFeedbackDocument(uid)
        && portalManager(uid)
        && resource.data.status == 'submitted'
        && request.resource.data.status in ['approved','rejected']
        && request.resource.data.reviewedByUid == request.auth.uid
        && request.resource.data.reviewedByName.size() > 0
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'status','reviewNote','reviewedByUid','reviewedByName','manualId','updatedAt'
        ])
        && ((request.resource.data.status == 'approved' && request.resource.data.manualId.size() > 0)
          || (request.resource.data.status == 'rejected' && request.resource.data.manualId == ''));
    }

    function validEditorManualBase() {
      return request.resource.data.keys().hasOnly([
          'recordType','kind','title','scope','scopeLabel','clientId','accountId','version','body',
          'url','required','audience','allowedUids','directorUid','origin','active',
          'createdAt','createdBy','updatedAt','updatedBy'
        ])
        && request.resource.data.title is string
        && request.resource.data.title.size() > 0
        && request.resource.data.title.size() <= 160
        && request.resource.data.scope is string && request.resource.data.scope in ['global','client','account']
        && request.resource.data.scopeLabel is string && request.resource.data.scopeLabel.size() <= 100
        && request.resource.data.clientId is string && request.resource.data.clientId.size() <= 160
        && request.resource.data.accountId is string && request.resource.data.accountId.size() <= 160
        && request.resource.data.version is string && request.resource.data.version.size() <= 40
        && request.resource.data.body is string && request.resource.data.body.size() <= 10000
        && request.resource.data.url is string && (request.resource.data.url == '' || request.resource.data.url.matches('^https?://.+'))
        && request.resource.data.required is bool
        && request.resource.data.audience is string && request.resource.data.audience in ['all','assigned']
        && request.resource.data.allowedUids is list && request.resource.data.allowedUids.size() <= 100
        && request.resource.data.directorUid is string && request.resource.data.directorUid.size() <= 160
        && request.resource.data.updatedAt is timestamp
        && request.resource.data.updatedBy is string && request.resource.data.updatedBy.size() > 0 && request.resource.data.updatedBy.size() <= 320;
    }

    function validFeedbackManualCreate(manualId) {
      let origin = request.resource.data.origin;
      let feedbackPath = /databases/$(database)/documents/editor_portals/$(origin.portalUid)/feedback/$(origin.feedbackId);
      return validEditorManualBase()
        && request.resource.data.recordType == 'editor_manual'
        && request.resource.data.kind == 'feedback'
        && request.resource.data.active == true
        && request.resource.data.audience == 'assigned'
        && request.resource.data.allowedUids.size() == 1
        && origin is map
        && origin.keys().hasOnly(['type','portalUid','feedbackId','jobId'])
        && origin.type == 'editor_feedback'
        && origin.portalUid is string && origin.portalUid.size() > 0
        && origin.feedbackId is string && origin.feedbackId.size() > 0
        && origin.jobId is string && origin.jobId.size() > 0
        && manualId == 'feedback_' + origin.portalUid + '_' + origin.feedbackId
        && request.resource.data.createdAt is timestamp
        && request.resource.data.createdBy is string && request.resource.data.createdBy.size() > 0 && request.resource.data.createdBy.size() <= 320
        && existsAfter(feedbackPath)
        && getAfter(feedbackPath).data.status == 'approved'
        && getAfter(feedbackPath).data.manualId == manualId
        && getAfter(feedbackPath).data.portalUid == origin.portalUid
        && getAfter(feedbackPath).data.jobId == origin.jobId
        && request.resource.data.allowedUids == [getAfter(feedbackPath).data.editorUid]
        && (owner() || (videoManager()
          && getAfter(feedbackPath).data.reviewedByUid == request.auth.uid
          && directorFor(origin.portalUid)));
    }

    function validOrdinaryManualWrite() {
      return validEditorManualBase()
        && request.resource.data.get('kind', '') != 'feedback'
        && !('origin' in request.resource.data)
        && (owner() || request.resource.data.directorUid == request.auth.uid);
    }

    match /editor_manuals/{manualId} {
      allow read: if owner() || (videoWorkspaceMember()
        && (resource.data.get('audience', '') == 'all'
          || (resource.data.get('allowedUids', []) is list
            && request.auth.uid in resource.data.get('allowedUids', []))
          // A director must be able to manage only the manuals they authored
          // for their external team.  This supports the scoped manager query
          // without reopening another director's client instructions.
          || (hasRole(request.auth.uid, '動画編集ディレクター')
            && resource.data.get('directorUid', '') == request.auth.uid)));
      allow create: if videoManager()
        && (validOrdinaryManualWrite() || validFeedbackManualCreate(manualId));
      allow update: if videoManager()
        && validOrdinaryManualWrite();
      allow delete: if false;
    }

    match /editor_suggestions/{suggestionId} {
      allow create: if approvedMember()
        && request.resource.data.keys().hasOnly([
          'category','message','replyCode','status','createdAt'
        ])
        && request.resource.data.category is string
        && request.resource.data.message is string
        && request.resource.data.message.size() > 0
        && request.resource.data.message.size() <= 2000
        && request.resource.data.replyCode is string
        && request.resource.data.status == '未確認';
      allow read, update: if owner();
      allow delete: if false;
    }

    match /editor_suggestion_replies/{replyCode} {
      allow read: if approvedMember();
      allow create, update: if owner()
        && request.resource.data.keys().hasOnly(['message','createdAt','updatedAt'])
        && request.resource.data.message is string
        && request.resource.data.message.size() > 0
        && request.resource.data.message.size() <= 2000;
      allow delete: if false;
    }

    // Owner-only quarantine for legacy external-editor settlement fields.
    // Migration order: archive the settlement here, then remove it from the
    // editor-visible portal job. Directors and external editors must not read
    // this collection because it reflects mono.create-to-director amounts.
    match /external_compensation_archive/{archiveId} {
      allow read, create, update: if owner();
      allow delete: if false;
    }

    // Required for collection-group dashboards in the internal manager app.
    match /{path=**}/editor_jobs/{jobId} {
      // Directors enumerate their current team from access and subscribe to
      // each allowed portal directly. A collection-group query cannot safely
      // re-evaluate team transfers or redact old settlement fields.
      allow read: if owner();
    }

    match /{path=**}/editor_invoices/{invoiceId} {
      allow read: if owner();
    }

    match /{path=**}/editor_profile/{documentId} {
      allow read: if owner();
    }

    match /{path=**}/invoice_authorizations/{authorizationId} {
      allow read: if owner();
    }
  }
}
