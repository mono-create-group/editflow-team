{
  "name": "editflow-team",
  "private": true,
  "version": "1.0.0",
  "description": "Deterministic local QA for the EditFlow static application.",
  "scripts": {
    "test": "npm run test:unit && npm run test:rules && npm run test:release",
    "test:unit": "node scripts/run-unit-tests.cjs",
    "test:dm-backend": "node scripts/run-unit-tests.cjs --only-dm-backend",
    "test:rules": "firebase emulators:exec --only firestore --project demo-editflow \"node tests/firestore-rules.test.cjs\"",
    "test:release": "python3 scripts/operational-qa.py --release && scripts/firestore-rules-dry-run.sh --check"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "5.0.2",
    "firebase": "12.18.0",
    "firebase-tools": "15.28.2"
  }
}
